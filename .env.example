# ========== 构建模式 ==========
# static:GitHub Pages 纯博客 | server:云服务器 博客+控制台+资源站
ASTRO_MODE=static

# 站点正式地址(影响 sitemap/RSS/OG 绝对链接)
SITE_URL=https://example.com

# ========== 动态版(server 模式)==========
# 控制台账号(首次启动创建,请务必修改)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-random-password

# 会话密钥(openssl rand -hex 32)
SESSION_SECRET=change-me-please

# SQLite 数据文件路径(默认 data/enlab.db)
DATABASE_PATH=./data/enlab.db
