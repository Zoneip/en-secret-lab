# 依赖与构建
node_modules/
dist/
dist-static/
dist-server/
.astro/
*.tsbuildinfo

# 静态站增量同步(本地状态,不入库)
.static-sync-state.json
.admin-build-tmp/

# 运行时数据(动态版)
data/*.db
data/*.db-*
data/uploads/

# 环境变量(敏感)
.env
.env.local
.env.*.local

# 站长本地上传资产(不入库,走控制台)
public/assets/fonts/uploaded/
public/assets/themes/*/wallpaper-*.png
public/assets/themes/*/wallpaper-*.jpg
public/assets/themes/*/wallpaper-*.jpeg
public/assets/themes/*/wallpaper-*.webp

# 编辑器与系统
.vscode/
.idea/
.DS_Store
*.swp

# 测试与日志
coverage/
playwright-report/
test-results/
*.log
npm-debug.log*
data/backups/

# npm 缓存重定向目录(磁盘空间紧张时的临时缓存)
.npm-cache/
