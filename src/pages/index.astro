---
/**
 * 首页:内容鸟瞰版
 * Hero(角色全家福)→ 公告 → 四栏目鸟瞰 → OC 展示 → 最新消息 → 技术栈
 * 区块开关与动效由控制台"站点设置 → 主页"调控
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import { featured } from '../lib/content/posts'
import { getSiteConfig } from '../lib/config'
import { getAllPosts } from '../lib/content/data'
import {
  getSiteColumns,
  getSiteOcs,
  getSiteAbout,
} from '../lib/content/site-content'
import { getTheme } from '../lib/theme/presets'
import { withBase } from '../lib/utils'
import { wallpaperCss } from '../lib/theme/engine'
import Mascot from '../components/mascot/Mascot.astro'
import PostCard from '../components/blog/PostCard.astro'

const config = getSiteConfig()
const hp = config.homepage
const visible = await getAllPosts()
const featuredPosts = featured(visible)
const recent = [...featuredPosts, ...visible.filter((p) => !p.featured)].slice(
  0,
  6,
)
const columns = (await getSiteColumns()).sort(
  (a, b) =>
    ['gray', 'yellow', 'purple', 'white'].indexOf(a.theme) -
    ['gray', 'yellow', 'purple', 'white'].indexOf(b.theme),
)
const ocs = (await getSiteOcs()).sort(
  (a, b) =>
    ['gray', 'yellow', 'purple', 'white'].indexOf(a.theme) -
    ['gray', 'yellow', 'purple', 'white'].indexOf(b.theme),
)
const about = await getSiteAbout()
const themeIds = ['gray', 'yellow', 'purple', 'white']

const techStack = [
  { name: 'Astro', desc: '内容驱动的网站框架', color: '#ff5d01' },
  { name: 'React', desc: '控制台与交互组件', color: '#61dafb' },
  { name: 'Tailwind CSS', desc: '控制台样式体系', color: '#38bdf8' },
  { name: 'SQLite', desc: '配置与下载计数存储', color: '#3fae6a' },
  { name: 'Pagefind', desc: '全站离线搜索', color: '#8b5cf6' },
  { name: 'Node.js', desc: '动态版运行时', color: '#4a90d9' },
]

const countByCategory = (cat: string) =>
  visible.filter((p) => p.category === cat).length
const themeNames: Record<string, string> = {
  gray: '灰糖',
  yellow: '蜜糖',
  purple: '葡萄',
  white: '棉花糖',
}
const ocNameByTheme: Record<string, string> = Object.fromEntries(
  ocs.map((o) => [o.theme, o.name]),
)
const mascotCfg = config.mascots
const heroMascots = themeIds.map((t) => {
  const cfg = mascotCfg[t as keyof typeof mascotCfg] ?? {}
  const fallbackName = ocNameByTheme[t] ?? themeNames[t]
  return {
    theme: t,
    character: cfg.character,
    role: cfg.role,
    name: cfg.name ?? fallbackName,
    imageUrl: cfg.imageUrl,
  }
})
const THEME_COLORS: Record<string, string> = {
  gray: '#5c677d',
  yellow: '#e59b2e',
  purple: '#8b5cf6',
  white: '#8fa3b8',
}
const col = (theme: string) => THEME_COLORS[theme] ?? '#5c677d'
const ocBg = (theme: string) => wallpaperCss(getTheme(theme).wallpaper.light)
const ocBgDark = (theme: string) => wallpaperCss(getTheme(theme).wallpaper.dark)
const ocOverlay = (theme: string, mode: 'light' | 'dark') =>
  getTheme(theme).palette[mode]['wallpaper-overlay']
const ocTok = (
  theme: string,
  key: keyof (typeof getTheme extends (t: string) => infer T
    ? T
    : never)['palette']['light'],
  mode: 'light' | 'dark',
) => getTheme(theme).palette[mode][key]
---

<BaseLayout title={config.title} description={config.description}>
  <div class="page-enter container">
    <!-- Hero:角色全家福 -->
    <section class="hero">
      <div class="hero-text">
        {
          about?.avatar ? (
            <img src={about.avatar} alt={about.nickname} class="hero-avatar" />
          ) : (
            <p class="hero-greet">这里的主人回来啦</p>
          )
        }
        <h1>{config.title}</h1>
        <p class="hero-desc">{config.description}</p>
        <div class="hero-actions">
          <a class="btn" href={withBase('/blog')}>看文章</a>
          <a class="btn btn-ghost" href={withBase('/about')}>认识 伙伴们</a>
        </div>
      </div>
      <div class="hero-mascots" data-motion-group="mascot" aria-hidden="true">
        {
          heroMascots.map((m) => (
            <div class="hero-mascot-item">
              <Mascot
                role={m.role ?? 'furry'}
                theme={m.theme}
                character={m.character}
                name={m.name}
                imageUrl={m.imageUrl}
                pixel={7}
              />
              <span class="hero-mascot-name">{m.name}</span>
            </div>
          ))
        }
      </div>
    </section>

    <!-- 公告 -->
    {
      hp.showAnnouncement && hp.announcement && (
        <section class="announcement">
          <span class="ann-badge">公告</span>
          <p class="ann-text">{hp.announcement}</p>
        </section>
      )
    }

    <!-- 四栏目鸟瞰 -->
    {
      hp.showColumnOverview && columns.length > 0 && (
        <section class="section">
          <h2 class="section-title">探索实验室</h2>
          <div class="column-grid">
            {columns.map((c) => (
              <a
                class="column-card"
                data-motion-group="cards"
                href={withBase(`/${c.id}`)}
                style={`--oc-color:${col(c.theme)}`}
              >
                <div class="column-card-head">
                  <Mascot role="furry" theme={c.theme} pixel={5} />
                  <span class="column-count">
                    {countByCategory(c.category)} 篇
                  </span>
                </div>
                <p class="column-name">{c.title}</p>
                <p class="column-sub">{c.subtitle}</p>
                <p class="column-desc">{c.description}</p>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <!-- OC 展示:四角色风格卡 -->
    {
      hp.showOcSection && ocs.length > 0 && (
        <section class="section">
          <h2 class="section-title">实验室的伙伴们</h2>
          <div class="oc-grid">
            {ocs.map((oc) => (
              <div
                class="oc-card"
                data-motion-group="cards"
                data-oc-theme={oc.theme}
                style={`--oc-bg-light:${ocBg(oc.theme)}; --oc-bg-dark:${ocBgDark(oc.theme)}; --oc-overlay-light:${ocOverlay(oc.theme, 'light')}; --oc-overlay-dark:${ocOverlay(oc.theme, 'dark')}; --oc-primary-light:${ocTok(oc.theme, 'primary', 'light')}; --oc-primary-dark:${ocTok(oc.theme, 'primary', 'dark')}; --oc-fg-light:${ocTok(oc.theme, 'fg', 'light')}; --oc-fg-dark:${ocTok(oc.theme, 'fg', 'dark')}; --oc-muted-light:${ocTok(oc.theme, 'fg-muted', 'light')}; --oc-muted-dark:${ocTok(oc.theme, 'fg-muted', 'dark')}`}
              >
                <div class="oc-card-top">
                  <Mascot role="boy" theme={oc.theme} pixel={6} />
                  <Mascot role="furry" theme={oc.theme} pixel={5} />
                </div>
                <p class="oc-card-name">{oc.name}</p>
                <p class="oc-card-sub">{oc.subtitle}</p>
                <div class="oc-card-traits">
                  {oc.traits.slice(0, 3).map((t) => (
                    <span class="oc-card-trait">{t}</span>
                  ))}
                </div>
                {oc.quote && <p class="oc-card-quote">「{oc.quote}」</p>}
              </div>
            ))}
          </div>
        </section>
      )
    }

    <!-- 最新消息 -->
    <section class="section">
      <h2 class="section-title">
        最新消息
        <a class="more underline-tail" href={withBase('/blog')}>全部文章</a>
      </h2>
      <div class="grid">
        {
          recent.map((p) => (
            <PostCard
              slug={p.slug}
              title={p.title}
              description={p.description}
              pubDate={p.pubDate}
              category={p.category}
              tags={p.tags}
              cover={p.cover}
            />
          ))
        }
      </div>
    </section>

    <!-- 技术栈 -->
    {
      hp.showTechStack && (
        <section class="section tech-section">
          <h2 class="section-title">驱动本站的技术</h2>
          <div class="tech-grid">
            {techStack.map((t) => (
              <div class="tech-card" style={`--tc:${t.color}`}>
                <span class="tech-dot" aria-hidden="true" />
                <span class="tech-name">{t.name}</span>
                <span class="tech-desc">{t.desc}</span>
              </div>
            ))}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .hero {
    display: flex;
    align-items: center;
    gap: 48px;
    padding: 72px 0 48px;
    flex-wrap: wrap;
  }
  .hero-text {
    flex: 1;
    min-width: 260px;
  }
  .hero-greet {
    font-family: var(--font-display);
    color: var(--primary);
    margin-bottom: 8px;
  }
  .hero-avatar {
    width: 72px;
    height: 72px;
    border-radius: 22px;
    object-fit: cover;
    margin-bottom: 14px;
    border: 3px solid var(--surface);
    box-shadow: var(--shadow);
  }
  .hero h1 {
    font-size: 2.6rem;
    margin-bottom: 12px;
  }
  .hero-desc {
    color: var(--fg-muted);
    max-width: 46ch;
  }
  .hero-actions {
    display: flex;
    gap: 12px;
    margin-top: 22px;
  }
  .hero-mascots {
    display: flex;
    gap: 10px;
    padding: 14px;
    border-radius: 24px;
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
  }
  .hero-mascot-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }
  .hero-mascot-name {
    font-size: 0.68rem;
    color: var(--fg-subtle);
  }

  /* 公告 */
  .announcement {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 20px;
    border-radius: 14px;
    background: var(--primary-soft);
    border: 1px solid color-mix(in srgb, var(--primary) 22%, transparent);
    margin-bottom: 8px;
    overflow: hidden;
  }
  .ann-badge {
    flex-shrink: 0;
    font-size: 0.72rem;
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--primary);
    color: var(--primary-fg);
  }
  .ann-text {
    font-size: 0.92rem;
    color: var(--fg);
  }

  .section {
    margin-top: 44px;
  }
  .section-title {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    font-size: 1.4rem;
    margin-bottom: 18px;
    color: var(--fg);
  }
  .more {
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--fg-subtle);
  }

  /* 四栏目鸟瞰 */
  .column-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 16px;
  }
  .column-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px;
    border-radius: 18px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--fg);
    text-decoration: none;
    box-shadow: var(--shadow);
    position: relative;
    overflow: hidden;
  }
  .column-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: var(--oc-color);
  }
  .column-card-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .column-count {
    font-size: 0.75rem;
    color: var(--fg-subtle);
  }
  .column-name {
    font-family: var(--font-display);
    font-size: 1.35rem;
    color: var(--oc-color);
  }
  .column-sub {
    font-size: 0.85rem;
    color: var(--fg-muted);
  }
  .column-desc {
    font-size: 0.82rem;
    color: var(--fg-subtle);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* OC 展示卡:2×2 排布 */
  .oc-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
  .oc-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 24px 18px;
    border-radius: 20px;
    border: 1px solid var(--border);
    background: var(--surface);
    box-shadow: var(--shadow);
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .oc-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--oc-bg-dark);
    opacity: 0.3;
    z-index: 0;
    pointer-events: none;
  }
  :root[data-mode='light'] .oc-card::after {
    background: var(--oc-bg-light);
  }
  .oc-card > * {
    position: relative;
    z-index: 1;
  }
  .oc-card-top {
    display: flex;
    gap: 2px;
  }
  .oc-card-name {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--oc-primary-dark);
  }
  .oc-card-sub {
    font-size: 0.85rem;
    color: var(--oc-muted-dark);
  }
  .oc-card-traits {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    justify-content: center;
  }
  .oc-card-trait {
    font-size: 0.72rem;
    padding: 2px 10px;
    border-radius: 999px;
    border: 1px solid var(--oc-primary-dark);
    color: var(--oc-muted-dark);
  }
  .oc-card-quote {
    font-family: var(--font-display);
    font-size: 0.9rem;
    color: var(--oc-primary-dark);
  }
  :root[data-mode='light'] .oc-card-name,
  :root[data-mode='light'] .oc-card-quote {
    color: var(--oc-primary-light);
  }
  :root[data-mode='light'] .oc-card-sub {
    color: var(--oc-muted-light);
  }
  :root[data-mode='light'] .oc-card-trait {
    border-color: var(--oc-primary-light);
    color: var(--oc-muted-light);
  }

  /* 最新消息 */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 22px;
  }

  /* 技术栈 */
  .tech-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 12px;
  }
  .tech-card {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 16px;
    border-radius: 14px;
    border: 1px solid var(--border);
    background: var(--surface);
  }
  .tech-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--tc);
    margin-bottom: 6px;
  }
  .tech-name {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--fg);
  }
  .tech-desc {
    font-size: 0.75rem;
    color: var(--fg-subtle);
  }

  /* 平板(< 1024px):Hero 改纵向堆叠,避免文字与全家福争宽 */
  @media (max-width: 1023px) {
    .hero {
      flex-direction: column;
      align-items: flex-start;
      gap: 28px;
    }
    .hero-mascots {
      align-self: stretch;
      justify-content: space-between;
    }
  }

  /* 大屏桌面(≥ 1200px):OC 卡 4 列一排 */
  @media (min-width: 1200px) {
    .oc-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (max-width: 640px) {
    .oc-grid {
      grid-template-columns: 1fr;
    }
    .hero {
      padding: 48px 0 24px;
      align-items: center;
      text-align: center;
    }
    .hero-desc {
      margin-inline: auto;
    }
    .hero-actions {
      justify-content: center;
      flex-wrap: wrap;
    }
    .hero h1 {
      font-size: 2rem;
    }
    /* 全家福小屏收窄间距防溢出(不用 scale,避免占位空隙) */
    .hero-mascots {
      gap: 4px;
      padding: 12px 8px;
    }
    .column-grid {
      grid-template-columns: 1fr;
    }
    .tech-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
