---
/**
 * 资源详情页:信息 + 直链下载(动态版计数)
 */
import type { GetStaticPaths } from 'astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getSiteResources } from '../../lib/content/site-resources'
import { isServer } from '../../lib/utils'
import { getDownloads } from '../../lib/admin/resources-store'

export const getStaticPaths = (async () => {
  if (!import.meta.env.ASTRO_MODE || import.meta.env.ASTRO_MODE === 'static') {
    const { getSiteResources } =
      await import('../../lib/content/site-resources')
    const resources = await getSiteResources()
    return resources.map((r) => ({ params: { id: r.id } }))
  }
  return []
}) satisfies GetStaticPaths

const id = Astro.params.id!
const resources = await getSiteResources()
const resource = resources.find((r) => r.id === id)

if (!resource) {
  return Astro.redirect('/404', 302)
}

const downloads = isServer ? getDownloads(id) : resource.downloads
const hasFile = Boolean(resource.file || resource.externalUrl)
---

<BaseLayout title={resource.title} description={resource.description}>
  <div class="page-enter container">
    <article class="card detail">
      <div class="detail-head">
        <span class="chip">{resource.category}</span>
        <span class="date">{resource.pubDate}</span>
      </div>
      <h1>{resource.title}</h1>
      <p class="desc">{resource.description}</p>
      <div class="tags">
        {resource.tags.map((t) => <span class="tag">#{t}</span>)}
      </div>
      <div class="dl-row">
        <span class="size">{resource.size ?? '大小未知'}</span>
        <a class="btn" href={`/api/resource/${resource.id}/download`}>
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M12 3v12m0 0 4-4m-4 4-4-4"></path>
            <path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"></path>
          </svg>
          下载
        </a>
        <span class="dl-count">已下载 {downloads} 次</span>
      </div>
      {!hasFile && <p class="hint">资源暂未配置下载链接,请稍后再来。</p>}
    </article>
  </div>
</BaseLayout>

<style>
  .detail {
    max-width: 720px;
    margin: 48px auto;
    padding: 36px 40px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .detail-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .date {
    font-size: 0.8rem;
    color: var(--fg-subtle);
  }
  .detail h1 {
    font-size: 1.9rem;
  }
  .desc {
    color: var(--fg-muted);
    line-height: 1.9;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tag {
    font-size: 0.8rem;
    color: var(--fg-subtle);
  }
  .dl-row {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 10px;
    padding-top: 18px;
    border-top: 1px dashed var(--border);
    flex-wrap: wrap;
  }
  .size {
    font-size: 0.85rem;
    color: var(--fg-subtle);
  }
  .dl-count {
    font-size: 0.78rem;
    color: var(--fg-subtle);
    margin-left: auto;
  }
  .hint {
    font-size: 0.85rem;
    color: var(--warning);
  }
  @media (max-width: 640px) {
    .detail {
      margin: 24px auto;
      padding: 24px 20px;
    }
  }
</style>
