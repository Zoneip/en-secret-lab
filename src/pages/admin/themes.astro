---
/**
 * 主题编辑器:色板 token 编辑 + 壁纸上传 + 实时预览 + 保存
 * 覆盖值写入 themeOverrides(仅保存被修改的 token,重置=清空覆盖)
 */
import { isServer } from '../../lib/utils'
import AdminLayout from '../../layouts/AdminLayout.astro'

export const prerender = !isServer
---

<AdminLayout title="主题编辑器" active="themes">
  <div class="editor">
    <aside class="card theme-list">
      <h2>选择主题</h2>
      <div data-theme-tabs></div>
    </aside>

    <div class="card palette-editor">
      <div class="editor-head">
        <div>
          <h2 data-palette-name>–</h2>
          <p class="hint" data-palette-desc>–</p>
        </div>
        <div class="head-actions">
          <button class="btn" data-reset-theme>重置此主题</button>
          <button class="btn btn-primary" data-save>保存修改</button>
        </div>
      </div>

      <section>
        <h3>色板(浅色)</h3>
        <div class="swatches" data-swatches="light"></div>
      </section>
      <section>
        <h3>色板(深色)</h3>
        <div class="swatches" data-swatches="dark"></div>
      </section>

      <section class="wallpaper-editor">
        <h3>背景壁纸</h3>
        <p class="hint">渐变格式:<code>linear-gradient(180deg, #fff 0%, #000 100%)</code>;或上传图片</p>
        <div class="wallpaper-row">
          <div class="field">
            <label>浅色</label>
            <input type="text" data-wallpaper="light" placeholder="渐变 CSS 或留空" />
          </div>
          <div class="field">
            <label>深色</label>
            <input type="text" data-wallpaper="dark" placeholder="渐变 CSS 或留空" />
          </div>
        </div>
        <div class="wallpaper-upload">
          <label class="btn" for="wp-upload">上传壁纸图片(浅)</label>
          <label class="btn" for="wp-upload-dark">上传壁纸图片(深)</label>
          <input type="file" id="wp-upload" hidden accept="image/*" data-upload="light" />
          <input type="file" id="wp-upload-dark" hidden accept="image/*" data-upload="dark" />
        </div>
        <div class="preview-box" data-preview>
          <div class="preview-box-label">实时预览</div>
          <div class="preview-stage">
            <div class="preview-card">
              <div class="preview-dot"></div>
              <div class="preview-lines"><i></i><i></i><i></i></div>
            </div>
            <p class="preview-mascot">🐾</p>
          </div>
        </div>
      </section>
    </div>
  </div>
</AdminLayout>

<script>
  interface Swatch {
    key: string
    label: string
  }

  const state = await fetch('/admin/api/state').then((r) => r.json())
  const presets = state.presets as Array<{
    id: string
    name: string
    description: string
    palette: { light: Record<string, string>; dark: Record<string, string> }
    wallpaper: { light: string; dark: string }
    override: { palette?: Record<string, string>; wallpaper?: { light?: string; dark?: string } } | null
  }>

  const SWATCH_ORDER: Swatch[] = [
    { key: 'bg', label: '页面背景' },
    { key: 'surface', label: '卡片' },
    { key: 'elevated', label: '悬浮层' },
    { key: 'fg', label: '主文本' },
    { key: 'fg-muted', label: '次级文本' },
    { key: 'fg-subtle', label: '弱文本' },
    { key: 'border', label: '描边' },
    { key: 'border-strong', label: '强描边' },
    { key: 'primary', label: '主色' },
    { key: 'primary-soft', label: '主色浅底' },
    { key: 'primary-fg', label: '主色文字' },
    { key: 'accent', label: '点缀色' },
    { key: 'accent-soft', label: '点缀浅底' },
    { key: 'accent-fg', label: '点缀文字' },
    { key: 'wallpaper-overlay', label: '壁纸遮罩' },
    { key: 'shadow', label: '阴影' },
  ]

  let current = presets[0]
  const overrides: Record<string, { light: Record<string, string>; dark: Record<string, string> }> = {}

  function mergedTokens(theme: (typeof presets)[number], mode: 'light' | 'dark'): Record<string, string> {
    return { ...theme.palette[mode], ...(theme.override?.palette ?? {}) }
  }

  function currentTokens(mode: 'light' | 'dark'): Record<string, string> {
    return mergedTokens(current, mode)
  }

  function renderTabs() {
    const box = document.querySelector('[data-theme-tabs]')!
    box.innerHTML = ''
    for (const t of presets) {
      const btn = document.createElement('button')
      btn.className = 'theme-tab' + (t.id === current.id ? ' active' : '')
      btn.innerHTML = `<span class="dot" style="background:${t.palette.light.primary}"></span>${t.name}`
      btn.addEventListener('click', () => {
        current = t
        renderAll()
      })
      box.appendChild(btn)
    }
  }

  function renderAll() {
    renderTabs()
    document.querySelector('[data-palette-name]')!.textContent = current.name
    document.querySelector('[data-palette-desc]')!.textContent = current.description
    for (const mode of ['light', 'dark'] as const) renderSwatches(mode)
    renderWallpaper()
  }

  function renderSwatches(mode: 'light' | 'dark') {
    const box = document.querySelector(`[data-swatches="${mode}"]`)!
    box.innerHTML = ''
    const tokens = currentTokens(mode)
    for (const s of SWATCH_ORDER) {
      const row = document.createElement('div')
      row.className = 'swatch'
      row.innerHTML = `
        <label title="${s.key}">${s.label}<code>--${s.key}</code></label>
        <input type="color" value="${tokens[s.key] ?? '#888888'}" data-token="${s.key}" />
        <input type="text" value="${tokens[s.key] ?? ''}" data-token-text="${s.key}" spellcheck="false" />
      `
      const color = row.querySelector<HTMLInputElement>(`[data-token="${s.key}"]`)!
      const text = row.querySelector<HTMLInputElement>(`[data-token-text="${s.key}"]`)!
      const apply = (value: string) => {
        const ov = (overrides[current.id] ??= { light: {}, dark: {} })
        ov[mode][s.key] = value
        document.documentElement.style.setProperty(`--${s.key}`, value)
      }
      color.addEventListener('input', () => {
        text.value = color.value
        apply(color.value)
      })
      text.addEventListener('change', () => {
        color.value = text.value
        apply(text.value)
      })
      box.appendChild(row)
    }
  }

  function renderWallpaper() {
    const wp = current.override?.wallpaper ?? {}
    const setVal = (mode: 'light' | 'dark', v: string) => {
      document.querySelector<HTMLInputElement>(`[data-wallpaper="${mode}"]`)!.value = v
    }
    setVal('light', wp.light ?? current.wallpaper.light.replace(/^gradient:/, ''))
    setVal('dark', wp.dark ?? current.wallpaper.dark.replace(/^gradient:/, ''))
  }

  // 壁纸输入 → 实时预览
  for (const mode of ['light', 'dark'] as const) {
    document.querySelector(`[data-wallpaper="${mode}"]`)!.addEventListener('change', (e) => {
      const v = (e.target as HTMLInputElement).value.trim()
      const ov = (overrides[current.id] ??= { light: {}, dark: {} })
      ov[mode].wallpaper = v.startsWith('linear-gradient') ? `gradient:${v}` : v
    })
  }

  // 壁纸图片上传
  for (const mode of ['light', 'dark'] as const) {
    document.querySelector(`[data-upload="${mode}"]`)!.addEventListener('change', async (e) => {
      const input = e.target as HTMLInputElement
      const file = input.files?.[0]
      if (!file) return
      const form = new FormData()
      form.append('kind', 'wallpaper')
      form.append('themeId', current.id)
      form.append('file', file)
      const res = await fetch('/admin/api/assets', { method: 'POST', body: form })
      if (!res.ok) {
        window.toast((await res.json()).error ?? '上传失败', true)
        return
      }
      const { asset } = await res.json()
      const ov = (overrides[current.id] ??= { light: {}, dark: {} })
      ov[mode].wallpaper = `url:${asset.path}`
      document.querySelector<HTMLInputElement>(`[data-wallpaper="${mode}"]`)!.value = asset.path
      window.toast('壁纸已上传')
    })
  }

  // 重置主题覆盖
  document.querySelector('[data-reset-theme]')!.addEventListener('click', async () => {
    if (!window.confirm(`确认将「${current.name}」重置为内置预设?`)) return
    const config = await fetch('/admin/api/state').then((r) => r.json())
    const site = {
      ...config.site,
      themeOverrides: (config.presets as typeof presets).reduce(
        (acc: Record<string, unknown>, p) => {
          if (p.id !== current.id) acc[p.id] = p.override
          return acc
        },
        {}
      ),
    }
    const res = await fetch('/admin/api/config', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(site),
    })
    if (res.ok) {
      window.toast('已重置')
      location.reload()
    }
  })

  // 保存
  document.querySelector('[data-save]')!.addEventListener('click', async () => {
    const config = await fetch('/admin/api/state').then((r) => r.json())
    const themeOverrides = (config.presets as typeof presets).reduce(
      (acc: Record<string, unknown>, p) => {
        if (p.override) acc[p.id] = p.override
        return acc
      },
      {}
    )
    for (const [themeId, ov] of Object.entries(overrides)) {
      const existing = themeOverrides[themeId] as
        | { palette?: Record<string, string>; wallpaper?: Record<string, string> }
        | undefined
      const target = existing ?? { palette: {}, wallpaper: {} }
      const pal: Record<string, string> = {}
      const wp: Record<string, string> = {}
      for (const mode of ['light', 'dark'] as const) {
        for (const [k, v] of Object.entries(ov[mode])) {
          if (k === 'wallpaper') wp[mode] = v
          else pal[k] = v
        }
      }
      target.palette = { ...(target.palette ?? {}), ...pal }
      target.wallpaper = { ...(target.wallpaper ?? {}), ...wp }
      themeOverrides[themeId] = target
    }
    const site = { ...config.site, themeOverrides }
    const res = await fetch('/admin/api/config', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(site),
    })
    if (res.ok) {
      window.toast('已保存')
      location.reload()
    } else {
      window.toast((await res.json()).error ?? '保存失败', true)
    }
  })

  // 实时预览:切到当前主题
  document.documentElement.dataset.theme = current.id
  renderAll()
</script>

<style>
  .editor {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 16px;
    align-items: start;
  }
  .theme-list h2,
  .palette-editor h2 {
    font-size: 15px;
    margin-bottom: 12px;
  }
  .theme-tab {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    padding: 9px 12px;
    border: none;
    background: none;
    border-radius: 10px;
    font-size: 13px;
    font-family: inherit;
    cursor: pointer;
    color: var(--a-fg-muted);
  }
  .theme-tab:hover {
    background: var(--a-primary-soft);
  }
  .theme-tab.active {
    background: var(--a-primary-soft);
    color: var(--a-primary);
    font-weight: 600;
  }
  .theme-tab .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, 0.12);
  }
  .editor-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 16px;
  }
  .hint {
    font-size: 12px;
    color: var(--a-fg-subtle);
  }
  .hint code {
    font-size: 11px;
    background: var(--a-primary-soft);
    padding: 1px 5px;
    border-radius: 5px;
  }
  .head-actions {
    display: flex;
    gap: 8px;
  }
  .palette-editor section {
    margin-bottom: 20px;
  }
  .palette-editor h3 {
    font-size: 13px;
    color: var(--a-fg-muted);
    margin-bottom: 10px;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--a-border);
  }
  .swatch {
    display: grid;
    grid-template-columns: 1fr 42px 130px;
    gap: 8px;
    align-items: center;
    padding: 5px 0;
  }
  .swatch label {
    display: flex;
    justify-content: space-between;
    font-size: 13px;
    color: var(--a-fg);
  }
  .swatch label code {
    font-size: 11px;
    color: var(--a-fg-subtle);
  }
  .swatch input[type='color'] {
    width: 42px;
    height: 30px;
    padding: 0;
    border: 1px solid var(--a-border);
    border-radius: 8px;
    background: none;
    cursor: pointer;
  }
  .swatch input[type='text'] {
    padding: 5px 8px;
    border: 1px solid var(--a-border);
    border-radius: 8px;
    font-size: 12px;
    font-family: monospace;
  }
  .wallpaper-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .wallpaper-upload {
    display: flex;
    gap: 10px;
    margin-top: 10px;
  }
  .preview-box {
    margin-top: 16px;
    border: 1px dashed var(--a-border);
    border-radius: 14px;
    padding: 14px;
  }
  .preview-box-label {
    font-size: 12px;
    color: var(--a-fg-subtle);
    margin-bottom: 10px;
  }
  .preview-stage {
    height: 120px;
    border-radius: 10px;
    background: var(--bg);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.3s;
  }
  .preview-card {
    width: 46%;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 12px;
    box-shadow: var(--shadow);
  }
  .preview-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--primary);
    margin-bottom: 8px;
  }
  .preview-lines {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .preview-lines i {
    height: 6px;
    border-radius: 3px;
    background: var(--fg-muted);
    opacity: 0.4;
  }
  .preview-lines i:last-child {
    width: 60%;
  }
  .preview-mascot {
    position: absolute;
    right: 12px;
    bottom: 8px;
    font-size: 22px;
    opacity: 0.5;
  }

  @media (max-width: 900px) {
    .editor {
      grid-template-columns: 1fr;
    }
    .wallpaper-row {
      grid-template-columns: 1fr;
    }
  }
</style>
