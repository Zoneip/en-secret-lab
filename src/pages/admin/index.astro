---
/**
 * 控制台仪表盘 v2:轻盈质感设计
 * 渐变欢迎区 + 像素吉祥物、数字滚动统计、文章概览、主题色板速览、活动时间线、系统状态
 */
import { isServer } from '../../lib/utils'
import AdminLayout from '../../layouts/AdminLayout.astro'

export const prerender = !isServer
---

<AdminLayout title="仪表盘" active="dashboard">
  <!-- 欢迎区 -->
  <section class="hero-card">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="hero-content">
      <div class="hero-text">
        <p class="hero-eyebrow" data-greet>–</p>
        <h2 data-hero-title>–</h2>
        <p class="hero-sub" data-today>–</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/admin/posts/new">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
            写新文章
          </a>
          <a class="btn btn-ghost-light" href="/admin/themes">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="13.5" cy="6.5" r="3.5" /><circle cx="6.5" cy="13.5" r="3.5" /><circle cx="15.5" cy="17.5" r="3.5" /><path d="M17 10 13.5 13.5M8.5 8.5 7 10" /></svg>
            调主题
          </a>
        </div>
      </div>
      <div class="hero-mascot" aria-hidden="true">
        <div class="hero-mascot-svg" data-mascot></div>
      </div>
    </div>
  </section>

  <!-- 统计 -->
  <section class="stat-grid" aria-label="站点统计">
    <div class="stat-card" data-stat="posts" style="--ac: #5c677d">
      <div class="stat-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><path d="M14 2v6h6" /><path d="M9 13h6M9 17h6" /></svg>
      </div>
      <div class="stat-body">
        <p class="stat-num" data-num="posts">0</p>
        <p class="stat-label">全部文章</p>
      </div>
      <span class="stat-badge" data-pub-ratio></span>
    </div>
    <div class="stat-card" data-stat="published" style="--ac: #3fae6a">
      <div class="stat-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M20 6 9 17l-5-5" /></svg>
      </div>
      <div class="stat-body">
        <p class="stat-num" data-num="published">0</p>
        <p class="stat-label">已发布</p>
      </div>
    </div>
    <div class="stat-card" data-stat="drafts" style="--ac: #d9a514">
      <div class="stat-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" /></svg>
      </div>
      <div class="stat-body">
        <p class="stat-num" data-num="drafts">0</p>
        <p class="stat-label">草稿</p>
      </div>
    </div>
    <div class="stat-card" data-stat="tags" style="--ac: #8b5cf6">
      <div class="stat-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12.6 2.9a2 2 0 0 0-1.4-.6H4a2 2 0 0 0-2 2v7.2a2 2 0 0 0 .6 1.4l9 9a2 2 0 0 0 2.8 0l7.2-7.2a2 2 0 0 0 0-2.8Z" /><circle cx="7.5" cy="7.5" r="1.5" /></svg>
      </div>
      <div class="stat-body">
        <p class="stat-num" data-num="tags">0</p>
        <p class="stat-label">标签</p>
      </div>
    </div>
    <div class="stat-card" data-stat="categories" style="--ac: #e59b2e">
      <div class="stat-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" /></svg>
      </div>
      <div class="stat-body">
        <p class="stat-num" data-num="categories">0</p>
        <p class="stat-label">分类</p>
      </div>
    </div>
    <div class="stat-card" data-stat="assets" style="--ac: #4a90d9">
      <div class="stat-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="8.5" cy="8.5" r="1.5" /><path d="m21 15-5-5L5 21" /></svg>
      </div>
      <div class="stat-body">
        <p class="stat-num" data-num="assets">0</p>
        <p class="stat-label">资产</p>
      </div>
    </div>
  </section>

  <div class="main-grid">
    <!-- 文章概览 -->
    <section class="card panel posts-panel">
      <div class="panel-head">
        <h2>文章概览</h2>
        <a class="panel-link" href="/admin/posts">
          全部
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
        </a>
      </div>
      <div class="post-list" data-post-list>
        <div class="skeleton-row" data-skeleton></div>
        <div class="skeleton-row" data-skeleton></div>
        <div class="skeleton-row" data-skeleton></div>
      </div>
    </section>

    <!-- 主题速览 -->
    <section class="card panel themes-panel">
      <div class="panel-head">
        <h2>主题色板</h2>
        <a class="panel-link" href="/admin/themes">编辑</a>
      </div>
      <div class="theme-grid" data-theme-grid>
        <div class="theme-skel" data-skeleton></div>
        <div class="theme-skel" data-skeleton></div>
      </div>
    </section>
  </div>

  <div class="main-grid">
    <!-- 最近动态 -->
    <section class="card panel activity-panel">
      <div class="panel-head">
        <h2>最近动态</h2>
      </div>
      <ol class="activity-list" data-activity-list></ol>
    </section>

    <!-- 系统状态 -->
    <section class="card panel system-panel">
      <div class="panel-head">
        <h2>系统状态</h2>
      </div>
      <div class="system-body">
        <div class="sys-row">
          <span class="sys-dot" aria-hidden="true"></span>
          <div>
            <p class="sys-label">运行模式</p>
            <p class="sys-value" data-sys-mode>–</p>
          </div>
        </div>
        <div class="sys-row">
          <span class="sys-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="m8 3 4 8 5-5 5 15H2L8 3z" /></svg>
          </span>
          <div>
            <p class="sys-label">Node 版本</p>
            <p class="sys-value" data-sys-node>–</p>
          </div>
        </div>
        <div class="sys-row">
          <span class="sys-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 3v12m0 0-4-4m4 4 4-4" /><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" /></svg>
          </span>
          <div class="sys-grow">
            <p class="sys-label">上传占用</p>
            <div class="usage-track" aria-hidden="true">
              <div class="usage-fill" data-usage-fill></div>
            </div>
            <p class="sys-value" data-sys-uploads>–</p>
          </div>
        </div>
      </div>
      <div class="quick-actions">
        <a class="qa" href="/admin/posts/new" title="写文章">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
        </a>
        <a class="qa" href="/admin/themes" title="主题">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="13.5" cy="6.5" r="3.5" /><circle cx="6.5" cy="13.5" r="3.5" /><circle cx="15.5" cy="17.5" r="3.5" /></svg>
        </a>
        <a class="qa" href="/admin/site" title="站点设置">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33h.01a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51h.01a1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82v.01a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" /></svg>
        </a>
        <a class="qa" href="/admin/assets" title="资产">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 16V4m0 0 4 4m-4-4-4 4" /><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" /></svg>
        </a>
        <a class="qa" href="/" target="_blank" title="查看前台">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" /><path d="M15 3h6v6" /><path d="M10 14 21 3" /></svg>
        </a>
      </div>
    </section>
  </div>
</AdminLayout>

<script>
  interface Activity {
    kind: 'publish' | 'draft' | 'upload'
    title: string
    time: number
    meta?: string
  }
  interface PostLite {
    slug: string
    title: string
    category: string
    tags: string[]
    pubDate: string
    draft: boolean
  }
  interface PresetLite {
    id: string
    name: string
    description: string
    palette: { light: Record<string, string>; dark: Record<string, string> }
  }

  const state = await fetch('/admin/api/state').then((r) => r.json())
  const posts: PostLite[] = await fetch('/admin/api/posts').then((r) => r.json()).then((d) => d.posts)

  function $<T extends Element = HTMLElement>(sel: string): T | null {
    return document.querySelector<T>(sel)
  }
  const fmt = (d: string) => new Date(d).toLocaleDateString('zh-CN')
  const timeAgo = (t: number) => {
    const diff = Date.now() - t
    const m = Math.floor(diff / 60000)
    if (m < 1) return '刚刚'
    if (m < 60) return `${m} 分钟前`
    const h = Math.floor(m / 60)
    if (h < 24) return `${h} 小时前`
    const d = Math.floor(h / 24)
    if (d < 30) return `${d} 天前`
    return new Date(t).toLocaleDateString('zh-CN')
  }

  // 问候
  const hour = new Date().getHours()
  const greet = hour < 6 ? '夜深了' : hour < 12 ? '早上好' : hour < 18 ? '下午好' : '晚上好'
  $('[data-greet]')!.textContent = greet
  $('[data-hero-title]')!.textContent = state.site.title
  $('[data-today]')!.textContent = new Date().toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    weekday: 'long',
  })

  // 数字滚动
  function countUp(el: HTMLElement, target: number) {
    const dur = 700
    const start = performance.now()
    const step = (now: number) => {
      const t = Math.min(1, (now - start) / dur)
      const eased = 1 - Math.pow(1 - t, 3)
      el.textContent = String(Math.round(target * eased))
      if (t < 1) requestAnimationFrame(step)
    }
    requestAnimationFrame(step)
  }
  const statMap: Record<string, number> = {
    posts: state.stats.posts,
    published: state.stats.published,
    drafts: state.stats.drafts,
    tags: state.stats.tags,
    categories: state.stats.categories,
    assets: state.stats.assets,
  }
  for (const [key, value] of Object.entries(statMap)) {
    countUp($(`[data-num="${key}"]`)!, value)
  }
  const pubRatio = state.stats.posts
    ? Math.round((state.stats.published / state.stats.posts) * 100)
    : 0
  $('[data-pub-ratio]')!.textContent = state.stats.posts ? `${pubRatio}% 已发布` : ''

  // 骨架屏清除
  document.querySelectorAll('[data-skeleton]').forEach((el) => el.remove())

  // 文章概览
  const postList = $('[data-post-list]')!
  if (posts.length === 0) {
    postList.innerHTML = `<div class="empty-box">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><path d="M14 2v6h6" /></svg>
      <p>还没有文章,写一篇吧</p>
      <a class="btn" href="/admin/posts/new">写新文章</a>
    </div>`
  } else {
    postList.innerHTML = posts
      .slice(0, 6)
      .map(
        (p, i) => `
        <a class="post-row" href="/admin/posts/${p.slug}" style="--i:${i}">
          <span class="post-cover" aria-hidden="true">${p.title.slice(0, 1)}</span>
          <span class="post-main">
            <span class="post-title">${p.title}</span>
            <span class="post-meta">${p.category} · ${fmt(p.pubDate)}</span>
          </span>
          ${p.draft ? '<span class="badge badge-draft">草稿</span>' : '<span class="badge badge-pub">已发布</span>'}
          <svg class="post-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
        </a>`
      )
      .join('')
  }

  // 主题色板速览
  const themeGrid = $('[data-theme-grid]')!
  themeGrid.innerHTML = (state.presets as PresetLite[])
    .map(
      (t) => `
      <a class="theme-mini" href="/admin/themes" style="--i:${(state.presets as PresetLite[]).indexOf(t)}">
        <span class="tm-swatches" aria-hidden="true">
          <i style="background:${t.palette.light.bg}"></i>
          <i style="background:${t.palette.light.surface}"></i>
          <i style="background:${t.palette.light.primary}"></i>
          <i style="background:${t.palette.light.accent}"></i>
        </span>
        <span class="tm-name">${t.name}</span>
        ${t.id === state.site.defaultTheme ? '<span class="tm-default">默认</span>' : ''}
      </a>`
    )
    .join('')

  // 活动时间线
  const activityBox = $('[data-activity-list]')!
  const activity: Activity[] = state.activity
  const KIND_META: Record<Activity['kind'], { label: string; cls: string }> = {
    publish: { label: '发布', cls: 'act-publish' },
    draft: { label: '草稿', cls: 'act-draft' },
    upload: { label: '上传', cls: 'act-upload' },
  }
  if (activity.length === 0) {
    activityBox.innerHTML = '<li class="empty-line">还没有动态</li>'
  } else {
    activityBox.innerHTML = activity
      .map(
        (a, i) => `
        <li class="act-row" style="--i:${i}">
          <span class="act-dot ${KIND_META[a.kind].cls}" aria-hidden="true"></span>
          <span class="act-body">
            <span class="act-title">${a.title}</span>
            <span class="act-meta">${KIND_META[a.kind].label}${a.meta ? ` · ${a.meta}` : ''} · ${timeAgo(a.time)}</span>
          </span>
        </li>`
      )
      .join('')
  }

  // 系统状态
  $('[data-sys-mode]')!.textContent = state.system.mode
  $('[data-sys-node]')!.textContent = state.system.node
  const mb = state.system.uploadBytes / 1024 / 1024
  $('[data-sys-uploads]')!.textContent = `${state.system.uploads} 个文件 · ${mb.toFixed(2)} MB`
  $('[data-usage-fill]')!.style.width = `${Math.min(100, Math.max(2, mb * 4))}%`

  // 吉祥物(像素 furry)
  const mascot = $('[data-mascot]')!
  const preset = (state.presets as PresetLite[]).find((p) => p.id === state.site.defaultTheme)!
  const pc = preset.palette.light
  // 简易像素兽耳头像(20×18)
  const px = 3
  const cells = [
    '..111......111..',
    '..1111....1111..',
    '..1221....1221..',
    '...111....111...',
    '....1111111111..',
    '..111111111111..',
    '..1ffffffffffff1',
    '..1ff55....55ff1',
    '..1ff55....55ff1',
    '..1f.22....22.f1',
    '..1wwwwwwwwwwww1',
    '..1www..55..www1',
    '..1wwwwwwwwwwww1',
    '...1ffffffffffff',
    '....ffffffffff...',
  ]
  const map: Record<string, string> = {
    '1': pc.primary,
    '2': pc.accent,
    f: '#F5EFE6',
    '5': '#332F36',
    w: '#FFFFFF',
  }
  mascot.innerHTML = `<svg width="${cells[0].length * px}" height="${cells.length * px}" viewBox="0 0 ${cells[0].length * px} ${cells.length * px}" shape-rendering="crispEdges" role="presentation">
    ${cells
      .flatMap((row, y) =>
        [...row].map((ch, x) => {
          const fill = map[ch]
          return fill
            ? `<rect x="${x * px}" y="${y * px}" width="${px}" height="${px}" fill="${fill}"/>`
            : ''
        })
      )
      .join('')}
  </svg>`
</script>

<style>
  /* ---------- 欢迎区 ---------- */
  .hero-card {
    position: relative;
    overflow: hidden;
    border-radius: 20px;
    padding: 30px 32px;
    margin-bottom: 18px;
    background: linear-gradient(120deg, color-mix(in srgb, var(--a-primary) 14%, var(--a-surface)), var(--a-surface) 55%);
    border: 1px solid color-mix(in srgb, var(--a-primary) 16%, var(--a-border));
  }
  .hero-glow {
    position: absolute;
    top: -60%;
    right: -8%;
    width: 380px;
    height: 380px;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--a-primary) 18%, transparent), transparent 65%);
    pointer-events: none;
  }
  .hero-content {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
  }
  .hero-eyebrow {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--a-primary);
    margin-bottom: 6px;
  }
  .hero-text h2 {
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .hero-sub {
    font-size: 13px;
    color: var(--a-fg-subtle);
    margin-top: 4px;
  }
  .hero-actions {
    display: flex;
    gap: 10px;
    margin-top: 18px;
  }
  .btn-ghost-light {
    background: var(--a-surface);
    border-color: color-mix(in srgb, var(--a-primary) 20%, var(--a-border));
    color: var(--a-fg);
  }
  .btn svg {
    width: 16px;
    height: 16px;
  }
  .hero-mascot {
    flex-shrink: 0;
    opacity: 0.9;
    animation: bob 3.6s ease-in-out infinite;
  }
  @keyframes bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-6px);
    }
  }

  /* ---------- 统计 ---------- */
  .stat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(168px, 1fr));
    gap: 14px;
    margin-bottom: 18px;
  }
  .stat-card {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 16px;
    background: var(--a-surface);
    border: 1px solid var(--a-border);
    border-radius: 16px;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.25s;
    animation: card-in 0.4s both;
    animation-delay: calc(var(--i, 0) * 0ms);
  }
  .stat-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 28px rgba(30, 40, 70, 0.08);
  }
  .stat-icon {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    color: #fff;
    background: linear-gradient(135deg, var(--ac), color-mix(in srgb, var(--ac) 60%, #fff));
    box-shadow: 0 4px 12px color-mix(in srgb, var(--ac) 30%, transparent);
    flex-shrink: 0;
  }
  .stat-icon svg {
    width: 20px;
    height: 20px;
  }
  .stat-num {
    font-size: 22px;
    font-weight: 700;
    line-height: 1.15;
    font-variant-numeric: tabular-nums;
  }
  .stat-label {
    font-size: 11px;
    color: var(--a-fg-subtle);
  }
  .stat-badge {
    position: absolute;
    top: 10px;
    right: 12px;
    font-size: 10px;
    color: var(--a-fg-subtle);
  }

  /* ---------- 面板 ---------- */
