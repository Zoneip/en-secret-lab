---
/**
 * 文章管理:全量列表(含草稿)、新建、删除、状态切换
 */
import { isServer } from '../../lib/utils'
import AdminLayout from '../../layouts/AdminLayout.astro'

export const prerender = !isServer
---

<AdminLayout title="文章管理" active="posts">
  <div class="card toolbar">
    <div class="filters">
      <button class="filter active" data-filter="all">全部</button>
      <button class="filter" data-filter="published">已发布</button>
      <button class="filter" data-filter="draft">草稿</button>
    </div>
    <button class="btn btn-primary" data-new-post>写新文章</button>
  </div>

  <div class="card table-card">
    <table class="post-table">
      <thead>
        <tr>
          <th>标题</th>
          <th class="hide-sm">分类</th>
          <th class="hide-sm">标签</th>
          <th>日期</th>
          <th class="hide-sm">状态</th>
          <th>操作</th>
        </tr>
      </thead>
      <tbody data-post-body></tbody>
    </table>
    <p class="empty" data-empty hidden>还没有文章</p>
  </div>
</AdminLayout>

<div class="modal-backdrop" data-modal-backdrop hidden>
  <form class="modal" data-new-form>
    <h3>写新文章</h3>
    <div class="field">
      <label>标题</label>
      <input type="text" name="title" required placeholder="文章标题" />
    </div>
    <div class="field">
      <label>slug(URL 标识,小写字母/数字/连字符)</label>
      <input type="text" name="slug" required placeholder="my-new-post" pattern="[a-z0-9-]+" />
    </div>
    <div class="row">
      <div class="field">
        <label>分类</label>
        <input type="text" name="category" value="随笔" />
      </div>
      <div class="field">
        <label>日期</label>
        <input type="date" name="pubDate" data-today />
      </div>
    </div>
    <div class="field">
      <label>标签(逗号分隔)</label>
      <input type="text" name="tags" placeholder="furry, 随笔" />
    </div>
    <div class="field">
      <label>
        <input type="checkbox" name="draft" value="1" checked />
        保存为草稿
      </label>
    </div>
    <div class="modal-actions">
      <button type="button" class="btn" data-cancel>取消</button>
      <button type="submit" class="btn btn-primary">创建并编辑</button>
    </div>
  </form>
</div>

<script>
  interface PostRow {
    slug: string
    title: string
    category: string
    tags: string[]
    pubDate: string
    draft: boolean
  }

  const fmt = (d: string) => new Date(d).toLocaleDateString('zh-CN')
  let posts: PostRow[] = []
  let filter = 'all'

  async function load() {
    const d = await fetch('/admin/api/posts').then((r) => r.json())
    posts = d.posts
    render()
  }

  function render() {
    const body = document.querySelector('[data-post-body]')!
    const visible = posts.filter((p) => (filter === 'all' ? true : filter === 'draft' ? p.draft : !p.draft))
    document.querySelector<HTMLElement>('[data-empty]')!.hidden = visible.length > 0
    body.innerHTML = visible
      .map(
        (p) => `
        <tr data-slug="${p.slug}">
          <td>
            <a class="title" href="/admin/posts/${p.slug}">${p.title}</a>
          </td>
          <td class="hide-sm"><span class="chip">${p.category}</span></td>
          <td class="hide-sm tags-cell">
            ${p.tags.slice(0, 3).map((t) => `<span class="tag">#${t}</span>`).join('')}
          </td>
          <td><time>${fmt(p.pubDate)}</time></td>
          <td class="hide-sm">
            <span class="badge ${p.draft ? 'badge-draft' : 'badge-pub'}" data-status="${p.slug}">${p.draft ? '草稿' : '已发布'}</span>
          </td>
          <td class="actions">
            <button class="link-btn" data-toggle="${p.slug}">${p.draft ? '发布' : '转草稿'}</button>
            <a class="link-btn" href="/blog/${p.slug}" target="_blank">查看</a>
            <button class="link-btn danger" data-del="${p.slug}">删除</button>
          </td>
        </tr>`
      )
      .join('')

    body.querySelectorAll<HTMLButtonElement>('[data-toggle]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const slug = btn.dataset.toggle!
        const post = posts.find((p) => p.slug === slug)!
        const res = await fetch(`/admin/api/posts/${slug}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ draft: !post.draft }),
        })
        if (res.ok) {
          window.toast(post.draft ? '已发布' : '已转为草稿')
          await load()
        } else {
          window.toast((await res.json()).error ?? '操作失败', true)
        }
      })
    })
    body.querySelectorAll<HTMLButtonElement>('[data-del]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const slug = btn.dataset.del!
        if (!window.confirm(`确认删除文章「${posts.find((p) => p.slug === slug)?.title}」?此操作不可恢复`)) return
        const res = await fetch(`/admin/api/posts/${slug}`, { method: 'DELETE' })
        if (res.ok) {
          window.toast('已删除')
          await load()
        } else {
          window.toast((await res.json()).error ?? '删除失败', true)
        }
      })
    })
  }

  document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((btn) => {
    btn.addEventListener('click', () => {
      filter = btn.dataset.filter!
      document.querySelectorAll('[data-filter]').forEach((b) => b.classList.remove('active'))
      btn.classList.add('active')
      render()
    })
  })

  // 新建模态框
  const backdrop = document.querySelector<HTMLElement>('[data-modal-backdrop]')!
  document.querySelector('[data-new-post]')!.addEventListener('click', () => {
    document.querySelector<HTMLInputElement>('[data-today]')!.value = new Date().toISOString().slice(0, 10)
    backdrop.hidden = false
  })
  document.querySelector('[data-cancel]')!.addEventListener('click', () => {
    backdrop.hidden = true
  })
  backdrop.addEventListener('click', (e) => {
    if (e.target === backdrop) backdrop.hidden = true
  })
  document.querySelector('[data-new-form]')!.addEventListener('submit', async (e) => {
    e.preventDefault()
    const fd = new FormData(e.target as HTMLFormElement)
    const payload = {
      slug: String(fd.get('slug')).trim(),
      title: String(fd.get('title')).trim(),
      category: String(fd.get('category')).trim() || '随笔',
      pubDate: String(fd.get('pubDate')),
      tags: String(fd.get('tags'))
        .split(/[,，]/)
        .map((t) => t.trim())
        .filter(Boolean),
      draft: fd.get('draft') === '1',
      body: '',
    }
    const res = await fetch('/admin/api/posts', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    })
    if (res.ok) {
      const d = await res.json()
      window.toast('已创建')
      location.href = `/admin/posts/${d.post.slug}`
    } else {
      window.toast((await res.json()).error ?? '创建失败', true)
    }
  })

  load()
</script>

<style>
  .toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    margin-bottom: 14px;
  }
  .filters {
    display: flex;
    gap: 6px;
  }
  .filter {
    padding: 6px 16px;
    border: 1px solid var(--a-border);
    background: var(--a-surface);
    border-radius: 999px;
    font-size: 12px;
    color: var(--a-fg-muted);
    cursor: pointer;
  }
  .filter.active {
    background: var(--a-primary);
    border-color: var(--a-primary);
    color: #fff;
  }
  .table-card {
    padding: 6px 16px 10px;
    overflow-x: auto;
  }
  .post-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }
  .post-table th {
    text-align: left;
    font-size: 11px;
    font-weight: 500;
    color: var(--a-fg-subtle);
    padding: 10px 8px;
    border-bottom: 1px solid var(--a-border);
    white-space: nowrap;
  }
  .post-table td {
    padding: 10px 8px;
    border-bottom: 1px solid var(--a-border);
    vertical-align: middle;
  }
  .post-table tr:last-child td {
    border-bottom: none;
  }
  .post-table tr:hover td {
    background: color-mix(in srgb, var(--a-primary-soft) 45%, transparent);
  }
  .title {
    color: var(--a-fg);
    text-decoration: none;
    font-weight: 500;
  }
  .title:hover {
    color: var(--a-primary);
  }
  .chip {
    font-size: 11px;
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--a-primary-soft);
    color: var(--a-primary);
  }
  .tags-cell .tag {
    font-size: 11px;
    color: var(--a-fg-subtle);
    margin-right: 6px;
  }
  .badge {
    font-size: 10px;
    padding: 2px 10px;
    border-radius: 999px;
  }
  .badge-pub {
    background: #e8f7ee;
    color: #2e7d4f;
  }
  .badge-draft {
    background: #fdf4de;
    color: #9a7b12;
  }
  .actions {
    display: flex;
    gap: 10px;
    white-space: nowrap;
  }
  .link-btn {
    background: none;
    border: none;
    padding: 0;
    font-size: 12px;
    color: var(--a-primary);
    cursor: pointer;
    font-family: inherit;
  }
  .link-btn.danger {
    color: #d9534f;
  }
  .empty {
    color: var(--a-fg-subtle);
    text-align: center;
    padding: 32px 0;
    font-size: 13px;
  }

  .modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: rgba(30, 34, 44, 0.45);
    display: grid;
    place-items: center;
    padding: 20px;
  }
  .modal {
    width: min(460px, 100%);
    background: var(--a-surface);
    border-radius: 16px;
    padding: 24px;
    box-shadow: 0 24px 60px rgba(20, 26, 40, 0.3);
  }
  .modal h3 {
    font-size: 16px;
    margin-bottom: 16px;
  }
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 8px;
  }

  @media (max-width: 720px) {
    .hide-sm {
      display: none;
    }
  }
</style>
