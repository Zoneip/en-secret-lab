---
/**
 * 站点设置:基础信息 / 功能开关 / 导航 / 字体 / 改密码
 */
import { isServer } from '../../lib/utils'
import AdminLayout from '../../layouts/AdminLayout.astro'

export const prerender = !isServer
---

<AdminLayout title="站点设置" active="site">
  <form class="card settings" data-site-form>
    <h2>基础信息</h2>
    <div class="field">
      <label for="s-title">站点标题</label>
      <input type="text" id="s-title" name="title" data-field="title" required />
    </div>
    <div class="field">
      <label for="s-desc">站点描述</label>
      <textarea id="s-desc" name="description" rows="2" data-field="description"></textarea>
    </div>
    <div class="row">
      <div class="field">
        <label for="s-author">作者署名</label>
        <input type="text" id="s-author" name="author" data-field="author" />
      </div>
      <div class="field">
        <label for="s-theme">默认主题</label>
        <select id="s-theme" name="defaultTheme" data-field="defaultTheme">
          <option value="gray">灰糖</option>
          <option value="yellow">蜜糖</option>
          <option value="purple">葡萄</option>
          <option value="white">棉花糖</option>
        </select>
      </div>
    </div>

    <h2>功能开关</h2>
    <div class="switches">
      <label class="switch"><input type="checkbox" data-feature="search" /><span>全站搜索</span></label>
      <label class="switch"><input type="checkbox" data-feature="comments" /><span>评论(预留)</span></label>
      <label class="switch"><input type="checkbox" data-feature="rss" /><span>RSS 订阅</span></label>
      <label class="switch"><input type="checkbox" data-feature="wallpapers" /><span>背景壁纸</span></label>
      <label class="switch"><input type="checkbox" data-feature="resources" /><span>资源站(预留)</span></label>
    </div>

    <h2>导航</h2>
    <div class="nav-editor" data-nav-list></div>
    <button type="button" class="btn" data-nav-add>+ 添加导航项</button>

    <h2>导入的字体</h2>
    <div class="fonts" data-font-list></div>
    <p class="hint">字体文件请在「资产」页上传,上传后回到本页填写 family 与角色。</p>

    <h2>管理员密码</h2>
    <div class="row">
      <div class="field">
        <label for="pwd">新密码(≥8 位)</label>
        <input type="password" id="pwd" data-new-password autocomplete="new-password" />
      </div>
      <div class="field">
        <label>&nbsp;</label>
        <button type="button" class="btn" data-change-pwd>更新密码</button>
      </div>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">保存站点设置</button>
    </div>
  </form>
</AdminLayout>

<script>
  interface NavItem {
    label: string
    url: string
  }
  interface SiteState {
    title: string
    description: string
    author: string
    defaultTheme: string
    features: Record<string, boolean>
    nav: NavItem[]
  }

  const state = await fetch('/admin/api/state').then((r) => r.json())
  const site: SiteState = state.site

  const field = (name: string) => document.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[data-field="${name}"]`)!
  field('title').value = site.title
  field('description').value = site.description
  field('author').value = site.author
  field('defaultTheme').value = site.defaultTheme
  for (const key of ['search', 'comments', 'rss', 'wallpapers', 'resources']) {
    const el = document.querySelector<HTMLInputElement>(`[data-feature="${key}"]`)!
    el.checked = Boolean(site.features[key])
  }

  const navList = document.querySelector('[data-nav-list]')!
  function renderNav() {
    navList.innerHTML = ''
    site.nav.forEach((item, i) => {
      const row = document.createElement('div')
      row.className = 'nav-row'
      row.innerHTML = `
        <input type="text" value="${item.label}" placeholder="名称" data-nav-label="${i}" />
        <input type="text" value="${item.url}" placeholder="/路径" data-nav-url="${i}" />
        <button type="button" class="btn btn-ghost" data-nav-del="${i}">删除</button>
      `
      row.querySelector(`[data-nav-del="${i}"]`)!.addEventListener('click', () => {
        site.nav.splice(i, 1)
        renderNav()
      })
      navList.appendChild(row)
    })
  }
  renderNav()
  document.querySelector('[data-nav-add]')!.addEventListener('click', () => {
    site.nav.push({ label: '新页面', url: '/' })
    renderNav()
  })

  // 改密码
  document.querySelector('[data-change-pwd]')!.addEventListener('click', async () => {
    const pwd = document.querySelector<HTMLInputElement>('[data-new-password]')!.value
    const res = await fetch('/admin/api/password', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ password: pwd }),
    })
    if (res.ok) {
      window.toast('密码已更新')
      document.querySelector<HTMLInputElement>('[data-new-password]')!.value = ''
    } else {
      window.toast((await res.json()).error ?? '更新失败', true)
    }
  })

  // 保存
  document.querySelector('[data-site-form]')!.addEventListener('submit', async (e) => {
    e.preventDefault()
    site.title = field('title').value.trim() || site.title
    site.description = field('description').value.trim()
    site.author = field('author').value.trim()
    site.defaultTheme = field('defaultTheme').value
    site.nav = [...navList.querySelectorAll('.nav-row')].map((row) => ({
      label: (row.querySelector('[data-nav-label]') as HTMLInputElement).value,
      url: (row.querySelector('[data-nav-url]') as HTMLInputElement).value,
    }))
    const res = await fetch('/admin/api/config', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(site),
    })
    if (res.ok) window.toast('已保存')
    else window.toast((await res.json()).error ?? '保存失败', true)
  })
</script>

<style>
  .settings h2 {
    font-size: 15px;
    margin: 22px 0 12px;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--a-border);
  }
  .settings h2:first-child {
    margin-top: 0;
  }
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .switches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 10px;
  }
  .switch {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 12px;
    border: 1px solid var(--a-border);
    border-radius: 10px;
    font-size: 13px;
    cursor: pointer;
  }
  .switch input {
    accent-color: var(--a-primary);
  }
  .nav-row {
    display: grid;
    grid-template-columns: 1fr 1fr auto;
    gap: 8px;
    margin-bottom: 8px;
  }
  .btn-ghost {
    border-color: var(--a-border);
    color: var(--a-fg-muted);
  }
  .fonts {
    font-size: 13px;
    color: var(--a-fg-muted);
    margin-bottom: 6px;
  }
  .form-actions {
    margin-top: 24px;
  }
  @media (max-width: 640px) {
    .row,
    .nav-row {
      grid-template-columns: 1fr;
    }
  }
</style>
