---
/** 文章编辑器:编辑(React) */
import { isServer } from '../../../lib/utils'
import AdminLayout from '../../../layouts/AdminLayout.astro'
import PostEditorPage from '../../../components/admin/pages/post-editor'

export const prerender = !isServer

export function getStaticPaths() {
  return []
}
---

<AdminLayout title="编辑文章" active="posts">
  <PostEditorPage
    isNew={false}
    slug={(Astro.params as { slug?: string }).slug}
    client:only="react"
  />
</AdminLayout>
