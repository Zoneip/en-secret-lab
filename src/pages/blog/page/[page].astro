---
/**
 * 分页路由:第 2 页起(/blog/page/2 …),第 1 页由 /blog 承担
 */
import { getAllPosts } from '../../../lib/content/data'
import BaseLayout from '../../../layouts/BaseLayout.astro'

import { getSiteConfig } from '../../../lib/config'
import PostCard from '../../../components/blog/PostCard.astro'
import Pagination from '../../../components/blog/Pagination.astro'
import EmptyState from '../../../components/ui/EmptyState.astro'
import { PAGE_SIZE } from '../index.astro'

export async function getStaticPaths() {
  const all = await getAllPosts()
  const totalPages = Math.max(1, Math.ceil(all.length / PAGE_SIZE))
  // 静态构建枚举第 2 页起的路径;props 仅作数据传递,SSR 下页面自算
  return Array.from({ length: totalPages - 1 }, (_, i) => ({
    params: { page: String(i + 2) },
  }))
}

// SSR 渲染不会调用 getStaticPaths,页面从 URL 参数自算数据,两种模式行为一致
const page = Number(Astro.params.page)
const all = await getAllPosts()
const totalPages = Math.max(1, Math.ceil(all.length / PAGE_SIZE))
const posts = all.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE)
const config = getSiteConfig()
---

<BaseLayout
  title={`文章 · 第 ${page} 页`}
  description={`${config.title} 的文章列表`}
>
  <div class="page-enter container" style="zoom:1.1">
    <header class="page-head">
      <h1>文章</h1>
      <p>第 {page} 页 · 共 {totalPages} 页</p>
    </header>

    {
      posts.length > 0 ? (
        <div class="grid">
          {posts.map((p) => (
            <PostCard
              slug={p.slug}
              title={p.title}
              description={p.description}
              pubDate={p.pubDate}
              category={p.category}
              tags={p.tags}
              cover={p.cover}
            />
          ))}
        </div>
      ) : (
        <EmptyState />
      )
    }

    <Pagination page={page} totalPages={totalPages} base="/blog" />
  </div>
</BaseLayout>

<style>
  .page-head {
    padding: 40px 0 24px;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .page-head h1 {
    font-size: 2rem;
  }
  .page-head p {
    color: var(--fg-subtle);
    font-size: 0.85rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 22px;
  }
</style>
