---
/**
 * 文章详情页:标题区 + 排版正文 + 目录 + 上下篇
 * 静态版走 astro:content 渲染,动态版实时读文件 + markdown-it
 */
import type { GetStaticPaths, MarkdownHeading } from 'astro'
// @ts-expect-error import 路径在运行时存在
import type { AstroComponentFactory } from 'astro/dist/runtime/server/index.js'
import { getCollection, render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { formatDate, readingTime, withBase } from '../../lib/utils'
import { isServer } from '../../lib/utils'
import { getAllPosts, getPostContent } from '../../lib/content/data'
import { renderBody } from '../../lib/content/render'
import PixelDivider from '../../components/mascot/PixelDivider.astro'
import TableOfContents from '../../components/blog/TableOfContents.astro'
import Chip from '../../components/ui/Chip.astro'

export const getStaticPaths = (async () => {
  if (isServer) return []
  const { getCollection } = await import('astro:content')
  const posts = await getCollection('posts')
  return posts
    .filter((p) => !p.data.draft)
    .map((post) => ({ params: { slug: post.slug }, props: { post } }))
}) satisfies GetStaticPaths

const slug = Astro.params.slug!
const content = await getPostContent(slug)

if (!content) {
  return Astro.redirect('/404', 302)
}

const post = content.post
const all = await getAllPosts()
const idx = all.findIndex((p) => p.slug === slug)
const prev = idx > 0 ? all[idx - 1] : undefined
const next = idx >= 0 && idx < all.length - 1 ? all[idx + 1] : undefined
// 同系列内上一篇/下一篇(连续阅读)
const seriesPosts = post.series
  ? all.filter((p) => p.series === post.series)
  : []
const seriesIdx = seriesPosts.findIndex((p) => p.slug === slug)
const seriesPrev = seriesIdx > 0 ? seriesPosts[seriesIdx - 1] : undefined
const seriesNext =
  seriesIdx >= 0 && seriesIdx < seriesPosts.length - 1
    ? seriesPosts[seriesIdx + 1]
    : undefined

// 正文渲染:静态版用 astro:content,动态版用 markdown-it(实时文件)
let contentHtml = ''
let contentHeadings: MarkdownHeading[]
let ContentComponent: AstroComponentFactory | null = null
if (isServer) {
  const r = renderBody(content.body)
  contentHtml = r.html
  contentHeadings = r.headings
} else {
  const entry = (await getCollection('posts')).find((p) => p.slug === slug)!
  const rendered = await render(entry)
  ContentComponent = rendered.Content
  contentHeadings = rendered.headings
}
const words = content.body
---

<BaseLayout title={post.title} description={post.description} type="article">
  <article class="post page-enter container">
    <header class="post-head">
      <div class="post-meta">
        <Chip href={withBase(`/categories/${encodeURIComponent(post.category)}`)}
          >{post.category}</Chip
        >
        <time datetime={post.pubDate.toISOString()}
          >{formatDate(post.pubDate)}</time
        >
        <span class="reading">{readingTime(words)} 分钟阅读</span>
      </div>
      <h1>{post.title}</h1>
      {post.description && <p class="subtitle">{post.description}</p>}
      <div class="tags">
        {
          post.tags.map((tag) => (
            <a class="chip" href={withBase(`/tags/${encodeURIComponent(tag)}`)}>
              #{tag}
            </a>
          ))
        }
      </div>
    </header>

    <PixelDivider />

    <div class="post-body">
      <div class="toc-wrap">
        <TableOfContents headings={contentHeadings ?? []} />
      </div>
      <div class="prose">
        {
          ContentComponent ? (
            <ContentComponent />
          ) : (
            <Fragment set:html={contentHtml} />
          )
        }
      </div>
    </div>
  </article>

  <div class="container">
    {
      post.series && (
        <p class="series-badge">
          系列 · {post.series}
          {seriesPrev || seriesNext ? (
            <span class="series-nav-links">
              {[
                seriesPrev && (
                  <a href={withBase(`/blog/${seriesPrev.slug}`)} class="series-link">
                    上一篇
                  </a>
                ),
                seriesNext && (
                  <a href={withBase(`/blog/${seriesNext.slug}`)} class="series-link">
                    下一篇
                  </a>
                ),
              ].filter(Boolean)}
            </span>
          ) : (
            ''
          )}
        </p>
      )
    }
    <nav class="adjacent" aria-label="上下篇文章">
      {
        prev ? (
          <a class="adj card" href={withBase(`/blog/${prev.slug}`)}>
            <span class="adj-label">上一篇</span>
            <span class="adj-title">{prev.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a class="adj card adj-next" href={withBase(`/blog/${next.slug}`)}>
            <span class="adj-label">下一篇</span>
            <span class="adj-title">{next.title}</span>
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </div>
</BaseLayout>

<style>
  .post-head {
    padding: 44px 0 24px;
    text-align: center;
  }
  .post-meta {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    font-size: 0.82rem;
    color: var(--fg-subtle);
    margin-bottom: 16px;
  }
  .post-head h1 {
    font-size: 2.2rem;
    max-width: 24em;
    margin: 0 auto;
  }
  .subtitle {
    color: var(--fg-muted);
    margin-top: 12px;
    font-size: 1.02rem;
  }
  .tags {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }
  .post-body {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 32px;
    margin-top: 12px;
    align-items: start;
  }
  .prose {
    min-width: 0;
  }
  .series-badge {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-top: 36px;
    padding: 8px 16px;
    border-radius: 12px;
    background: var(--primary-soft);
    color: var(--primary);
    font-size: 0.85rem;
  }
  .series-nav-links {
    display: flex;
    gap: 12px;
  }
  .series-link {
    font-size: 0.8rem;
  }
  .adjacent {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 44px;
  }
  .adj {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 20px;
    color: var(--fg);
  }
  .adj:hover {
    transform: translateY(-2px);
  }
  .adj-next {
    text-align: right;
  }
  .adj-label {
    font-size: 0.75rem;
    color: var(--fg-subtle);
  }
  .adj-title {
    font-family: var(--font-display);
    font-size: 1.02rem;
  }

  @media (max-width: 900px) {
    .post-body {
      grid-template-columns: 1fr;
    }
    .toc-wrap {
      display: none;
    }
  }
  @media (max-width: 640px) {
    .series-badge {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-top: 36px;
      padding: 8px 16px;
      border-radius: 12px;
      background: var(--primary-soft);
      color: var(--primary);
      font-size: 0.85rem;
    }
    .series-nav-links {
      display: flex;
      gap: 12px;
    }
    .series-link {
      font-size: 0.8rem;
    }
    .adjacent {
      grid-template-columns: 1fr;
    }
    .post-head h1 {
      font-size: 1.7rem;
    }
  }
</style>
