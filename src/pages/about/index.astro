---
/** 关于页 v4:横向滚动单页(5 屏),滚动切换时直接把当前屏主题设为全局主题
 *  与栏目页同机制(forceTheme):壁纸/顶部栏/配色全部跟随当前屏,资源只渲染当前主题一层
 */
import BaseLayout from '../../layouts/BaseLayout.astro'
import AboutNav from '../../components/about/AboutNav.astro'
import OCScreen from '../../components/about/OCScreen.astro'
import Mascot from '../../components/mascot/Mascot.astro'
import { getSiteAbout, getSiteOcs } from '../../lib/content/site-content'

const about = await getSiteAbout()
const ocs = (await getSiteOcs()).sort(
  (a, b) =>
    ['gray', 'yellow', 'purple', 'white'].indexOf(a.theme) -
    ['gray', 'yellow', 'purple', 'white'].indexOf(b.theme)
)
---

<BaseLayout title="关于" description="关于这个站点和它的主人" hideFooter>
  <div class="snap-wrap" data-snap-wrap>
    <div class="snap-scroller" data-snap-scroller>
      <!-- 屏1:hero(默认主题) -->
      <section class="snap-section hero-screen" data-screen data-screen-theme="">
        <div class="hero-inner">
          {about && (
            <>
              <div class="hero-avatar-wrap">
                {about.avatar ? (
                  <img src={about.avatar} alt={about.nickname} class="hero-avatar" />
                ) : (
                  <div class="hero-mascots" data-motion-group="mascot" aria-hidden="true">
                    <Mascot role="furry" pixel={7} />
                    <Mascot role="boy" pixel={6} />
                  </div>
                )}
              </div>
              <p class="hero-nickname">{about.nickname}</p>
              <p class="hero-tagline">{about.tagline}</p>
              <ul class="hero-intro">
                {about.intro.map((line) => (
                  <li>{line}</li>
                ))}
              </ul>
              {about.links.length > 0 && (
                <div class="hero-links">
                  {about.links.map((link) => (
                    <a class="chip" href={link.url} target="_blank" rel="noopener noreferrer">
                      {link.label}
                    </a>
                  ))}
                </div>
              )}
            </>
          )}
          <div class="hero-scroll-hint" aria-hidden="true">
            <span>左右滑动看看四位伙伴</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 6l-5 6 5 6M19 6l-5 6 5 6" /></svg>
          </div>
        </div>
      </section>

      <!-- 屏2-5:四个 OC(各自主题) -->
      {ocs.map((oc) => (
        <OCScreen oc={oc} />
      ))}
    </div>

    <AboutNav count={ocs.length + 1} />
  </div>
</BaseLayout>

<style>
  :global(.snap-wrap) {
    position: fixed;
    inset: 0;
    top: var(--header-h);
    bottom: 0;
  }
  :global(.snap-scroller) {
    height: 100%;
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  :global(.snap-scroller::-webkit-scrollbar) {
    display: none;
  }
  :global(.snap-section) {
    min-height: 100%;
    flex: 0 0 100%;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow-y: auto;
    padding: 48px 56px 56px;
    /* 屏外完全脱离绘制 */
    visibility: hidden;
  }
  :global(.snap-section.in-view) {
    visibility: visible;
  }

  /* ===== 屏1 hero(配色随默认主题) ===== */
  .hero-screen {
    text-align: center;
  }
  .hero-inner {
    max-width: 640px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    animation: hero-in 0.6s var(--ease-soft) 0.1s both;
  }
  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .hero-avatar-wrap {
    display: flex;
    justify-content: center;
  }
  .hero-avatar {
    width: 132px;
    height: 132px;
    border-radius: 32px;
    object-fit: cover;
    border: 3px solid var(--surface);
    box-shadow: var(--shadow);
  }
  .hero-mascots {
    display: flex;
    gap: 2px;
    padding: 10px;
    border-radius: 20px;
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
  }
  .hero-nickname {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 3rem);
    color: var(--primary);
  }
  .hero-tagline {
    color: var(--fg-muted);
  }
  .hero-intro {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
    color: var(--fg);
    font-size: 0.92rem;
  }
  .hero-links {
    display: flex;
    gap: 8px;
    margin-top: 6px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .hero-scroll-hint {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    color: var(--fg-subtle);
    font-size: 0.8rem;
    margin-top: 24px;
    animation: hint-bob 2s ease-in-out infinite;
  }
  .hero-scroll-hint svg {
    width: 20px;
    height: 20px;
  }
  @keyframes hint-bob {
    0%,
    100% {
      transform: translateX(0);
    }
    50% {
      transform: translateX(6px);
    }
  }
  @media (max-width: 760px) {
    :global(.snap-section) {
      padding: 40px 24px 48px;
    }
    .hero-nickname {
      font-size: 2rem;
    }
  }
</style>

<script is:inline>
  ;(function () {
    const scroller = document.querySelector('[data-snap-scroller]')
    const screens = [...document.querySelectorAll('[data-screen]')]
    if (!scroller || !screens.length) return

    let currentIdx = -1

    // 当前屏主题 → 全局主题(与栏目页 forceTheme 同机制)
    function applyScreenTheme(idx) {
      if (idx === currentIdx) return
      currentIdx = idx
      const theme = screens[idx]?.dataset.screenTheme
      const html = document.documentElement
      if (theme) {
        html.dataset.theme = theme
        html.dataset.forceTheme = theme
        html.dataset.themeLocked = 'true'
      } else {
        // hero 屏:恢复模式默认主题
        delete html.dataset.forceTheme
        const dark = html.dataset.mode === 'dark'
        html.dataset.theme = dark
          ? document.body.dataset.defaultThemeDark ?? 'purple'
          : document.body.dataset.defaultThemeLight ?? 'gray'
        html.dataset.themeLocked = 'false'
      }
      window.dispatchEvent(new CustomEvent('enlab:theme-change'))
    }

    // 滚动 → 当前屏(节流 rAF)
    scroller.addEventListener(
      'scroll',
      () => {
        requestAnimationFrame(() => {
          const idx = Math.round(scroller.scrollLeft / scroller.clientWidth)
          applyScreenTheme(Math.min(Math.max(0, idx), screens.length - 1))
        })
      },
      { passive: true }
    )

    // 屏外裁剪 + 激活状态(入场动画/打字机/bob 只给当前屏)
    const inViewIo = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          entry.target.classList.toggle('in-view', entry.isIntersecting)
          if (entry.isIntersecting && entry.intersectionRatio > 0.5) {
            entry.target.classList.add('active')
          } else if (entry.intersectionRatio < 0.1) {
            entry.target.classList.remove('active')
          }
        }
      },
      { threshold: [0, 0.1, 0.5, 0.9, 1] }
    )
    screens.forEach((s) => inViewIo.observe(s))

    // 打字机:进入视口播放一次
    const TYPE_SPEED = { slow: 95, normal: 55, fast: 28 }
    function startTyping(sec) {
      const q = sec.querySelector('[data-quote-effect="typing"]')
      if (!q || q.dataset.typed === '1') return
      q.dataset.typed = '1'
      const text = q.querySelector('.quote-text')
      if (!text) return
      const full = text.dataset.quoteFull ?? ''
      const speed = TYPE_SPEED[q.dataset.quoteSpeed] ?? 55
      text.textContent = ''
      let i = 0
      const timer = window.setInterval(() => {
        i++
        text.textContent = `「${full.slice(0, i)}」`
        if (i >= full.length) window.clearInterval(timer)
      }, speed)
    }
    const quoteIo = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) startTyping(entry.target)
        }
      },
      { threshold: 0.4 }
    )
    screens.forEach((s) => quoteIo.observe(s))

    // 初始化
    applyScreenTheme(0)
  })()
</script>
