---
/** 关于页 - 第 1 屏(hero 自我介绍):独立子页面,动画与其它屏隔离 */
import BaseLayout from '../../layouts/BaseLayout.astro'
import AboutNav from '../../components/about/AboutNav.astro'
import Mascot from '../../components/mascot/Mascot.astro'
import { getSiteConfig } from '../../lib/config'
import { getSiteAbout } from '../../lib/content/site-content'
import { getTheme } from '../../lib/theme/presets'

const about = await getSiteAbout()
const siteConfig = getSiteConfig()
const siteAuthor = siteConfig.author
const pgTheme = getTheme(siteConfig.defaultTheme)
const pg = pgTheme.palette.light
const pgd = pgTheme.palette.dark
const V = (k: string) => pg[k]
const Vd = (k: string) => pgd[k]
const SNAP = `--pg-bg:${V('bg')}; --pg-surface:${V('surface')}; --pg-elevated:${V('elevated')}; --pg-fg:${V('fg')}; --pg-fg-muted:${V('fg-muted')}; --pg-fg-subtle:${V('fg-subtle')}; --pg-primary:${V('primary')}; --pg-primary-soft:${V('primary-soft')}; --pg-primary-fg:${V('primary-fg')}; --pg-accent:${V('accent')}; --pg-accent-soft:${V('accent-soft')}; --pg-border:${V('border')}; --pg-border-strong:${V('border-strong')}; --pg-overlay:${V('wallpaper-overlay')}; --pg-shadow:${V('shadow')}; --pg-bg-dark:${Vd('bg')}; --pg-surface-dark:${Vd('surface')}; --pg-elevated-dark:${Vd('elevated')}; --pg-fg-dark:${Vd('fg')}; --pg-fg-muted-dark:${Vd('fg-muted')}; --pg-fg-subtle-dark:${Vd('fg-subtle')}; --pg-primary-dark:${Vd('primary')}; --pg-primary-soft-dark:${Vd('primary-soft')}; --pg-primary-fg-dark:${Vd('primary-fg')}; --pg-accent-dark:${Vd('accent')}; --pg-accent-soft-dark:${Vd('accent-soft')}; --pg-border-dark:${Vd('border')}; --pg-border-strong-dark:${Vd('border-strong')}; --pg-overlay-dark:${Vd('wallpaper-overlay')}; --pg-shadow-dark:${Vd('shadow')}`
---

<BaseLayout title="关于" description="关于这个站点和它的主人" hideFooter>
  <div class="about-root" style={SNAP}>
    <section class="about-stage hero-screen">
      <div class="hero-bg" aria-hidden="true"></div>
      <div class="hero-inner">
        {about && (
          <>
            <div class="hero-avatar-wrap">
              {about.avatar ? (
                <img src={about.avatar} alt={about.nickname} class="hero-avatar" />
              ) : (
                <div class="hero-mascots" data-motion-group="mascot" aria-hidden="true">
                  <Mascot role="furry" pixel={7} />
                  <Mascot role="boy" pixel={6} />
                </div>
              )}
            </div>
            <p class="hero-nickname">{about.nickname}</p>
            <p class="hero-tagline">{about.tagline}</p>
            <ul class="hero-intro">
              {about.intro.map((line) => (
                <li>{line}</li>
              ))}
            </ul>
            {about.links.length > 0 && (
              <div class="hero-links">
                {about.links.map((link) => (
                  <a class="chip" href={link.url} target="_blank" rel="noopener noreferrer">
                    {link.label}
                  </a>
                ))}
              </div>
            )}
          </>
        )}
        <div class="hero-scroll-hint" aria-hidden="true">
          <span>滚动看看四位伙伴</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 6l-5 6 5 6M19 6l-5 6 5 6" /></svg>
        </div>
      </div>
      <footer class="screen-footer">
        <span>© {new Date().getFullYear()} {siteAuthor} · 秘密实验室</span>
        <a href="/rss.xml">RSS</a>
      </footer>
    </section>
    <AboutNav current={0} total={5} />
  </div>
</BaseLayout>

<style>
  /* 深浅色间接层:深色默认,浅色覆盖 */
  .about-root {
    --p-bg: var(--pg-bg-dark, var(--pg-bg));
    --p-surface: var(--pg-surface-dark, var(--pg-surface));
    --p-elevated: var(--pg-elevated-dark, var(--pg-elevated));
    --p-fg: var(--pg-fg-dark, var(--pg-fg));
    --p-fg-muted: var(--pg-fg-muted-dark, var(--pg-fg-muted));
    --p-fg-subtle: var(--pg-fg-subtle-dark, var(--pg-fg-subtle));
    --p-primary: var(--pg-primary-dark, var(--pg-primary));
    --p-primary-soft: var(--pg-primary-soft-dark, var(--pg-primary-soft));
    --p-primary-fg: var(--pg-primary-fg-dark, var(--pg-primary-fg));
    --p-accent: var(--pg-accent-dark, var(--pg-accent));
    --p-accent-soft: var(--pg-accent-soft-dark, var(--pg-accent-soft));
    --p-border: var(--pg-border-dark, var(--pg-border));
    --p-border-strong: var(--pg-border-strong-dark, var(--pg-border-strong));
    --p-overlay: var(--pg-overlay-dark, var(--pg-overlay));
    --p-shadow: var(--pg-shadow-dark, var(--pg-shadow));
  }
  :root[data-mode='light'] .about-root {
    --p-bg: var(--pg-bg);
    --p-surface: var(--pg-surface);
    --p-elevated: var(--pg-elevated);
    --p-fg: var(--pg-fg);
    --p-fg-muted: var(--pg-fg-muted);
    --p-fg-subtle: var(--pg-fg-subtle);
    --p-primary: var(--pg-primary);
    --p-primary-soft: var(--pg-primary-soft);
    --p-primary-fg: var(--pg-primary-fg);
    --p-accent: var(--pg-accent);
    --p-accent-soft: var(--pg-accent-soft);
    --p-border: var(--pg-border);
    --p-border-strong: var(--pg-border-strong);
    --p-overlay: var(--pg-overlay);
    --p-shadow: var(--pg-shadow);
  }
  .hero-screen {
    position: fixed;
    inset: 0;
    top: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow-y: auto;
    padding: 48px 56px 56px;
    text-align: center;
  }
  .hero-bg {
    position: fixed;
    inset: 0;
    top: var(--header-h);
    background: var(--p-bg-dark, var(--p-bg));
    z-index: -2;
  }
  :root[data-mode='light'] .hero-bg {
    background: var(--p-bg);
  }
  .hero-inner {
    max-width: 640px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    animation: screen-in 0.7s var(--ease-soft) 0.1s both;
  }
  @keyframes screen-in {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .hero-avatar-wrap {
    display: flex;
    justify-content: center;
  }
  .hero-avatar {
    width: 132px;
    height: 132px;
    border-radius: 36px;
    object-fit: cover;
    border: 3px solid var(--p-surface);
    box-shadow: var(--p-shadow);
  }
  .hero-mascots {
    display: flex;
    gap: 2px;
    padding: 10px;
    border-radius: 22px;
    background: var(--p-surface);
    border: 1px solid var(--p-border);
    box-shadow: var(--p-shadow);
  }
  .hero-nickname {
    font-family: var(--font-display);
    font-size: 2.6rem;
    color: var(--p-primary);
  }
  .hero-tagline {
    color: var(--p-fg-muted);
  }
  .hero-intro {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
    color: var(--p-fg);
    font-size: 0.92rem;
  }
  .hero-links {
    display: flex;
    gap: 8px;
    margin-top: 6px;
  }
  .hero-scroll-hint {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    color: var(--p-fg-subtle);
    font-size: 0.8rem;
    margin-top: 24px;
    animation: hint-bob 2s ease-in-out infinite;
  }
  .hero-scroll-hint svg {
    width: 20px;
    height: 20px;
  }
  @keyframes hint-bob {
    0%,
    100% {
      transform: translateX(0);
    }
    50% {
      transform: translateX(6px);
    }
  }
  .screen-footer {
    position: absolute;
    bottom: 14px;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    font-size: 0.72rem;
    color: var(--p-fg-subtle);
    z-index: 5;
    pointer-events: none;
  }
  .screen-footer a {
    pointer-events: auto;
    color: var(--p-fg-subtle);
    text-decoration: none;
  }
  .screen-footer a:hover {
    color: var(--p-primary);
  }
  @media (max-width: 760px) {
    .hero-nickname {
      font-size: 2rem;
    }
  }
</style>
