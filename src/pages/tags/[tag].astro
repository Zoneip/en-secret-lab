---
/** 标签归档页 */
import { getCollection } from 'astro:content'
import type { GetStaticPaths } from 'astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { published } from '../../lib/content/posts'
import { aggregateByKey } from '../../lib/content/taxonomy'
import PostCard from '../../components/blog/PostCard.astro'
import EmptyState from '../../components/ui/EmptyState.astro'

export const getStaticPaths = (async () => {
  const posts = published(await getCollection('posts'))
  return aggregateByKey(posts, 'tags').map((tag) => ({
    params: { tag: tag.name },
    props: {
      tag: tag.name,
      posts: posts.filter((p) => p.tags.includes(tag.name)),
    },
  }))
}) satisfies GetStaticPaths

const { tag, posts } = Astro.props
---

<BaseLayout title={`#${tag}`} description={`标签 ${tag} 的文章`}>
  <div class="page-enter">
    <header class="page-head">
      <h1>
        <span class="hash">#</span>
        {tag}
      </h1>
      <p>{posts.length} 篇文章</p>
    </header>

    {posts.length > 0 ? (
      <div class="grid">
        {posts.map((p) => (
          <PostCard
            slug={p.slug}
            title={p.title}
            description={p.description}
            pubDate={p.pubDate}
            category={p.category}
            tags={p.tags}
            cover={p.cover}
           
          />
        ))}
      </div>
    ) : (
      <EmptyState title="这个标签下还没有文章" />
    )}
  </div>
</BaseLayout>

<style>
  .page-head {
    padding: 40px 0 24px;
  }
  .page-head h1 {
    font-size: 2rem;
    color: var(--primary);
  }
  .hash {
    opacity: 0.6;
  }
  .page-head p {
    color: var(--fg-subtle);
    font-size: 0.85rem;
    margin-top: 4px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 22px;
  }
</style>
