---
/** 分类总览 */
import { getAllPosts } from '../../lib/content/data'
import BaseLayout from '../../layouts/BaseLayout.astro'

import { aggregateByKey } from '../../lib/content/taxonomy'

const posts = await getAllPosts()
const categories = aggregateByKey(posts, 'category')
---

<BaseLayout fillViewport title="分类" description="全站分类总览">
  <div class="page-enter container">
    <header class="page-head">
      <h1>分类</h1>
      <p>{categories.length} 个分类</p>
    </header>

    <div class="cats">
      {
        categories.map((c) => (
          <a
            class="cat-card card"
            href={`/categories/${encodeURIComponent(c.name)}`}
          >
            <span class="cat-name">{c.name}</span>
            <span class="cat-count">{c.count} 篇</span>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .page-head {
    padding: 40px 0 24px;
    text-align: center;
  }
  .page-head h1 {
    font-size: 2rem;
    margin-bottom: 6px;
  }
  .page-head p {
    color: var(--fg-subtle);
    font-size: 0.85rem;
  }
  .cats {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 16px;
  }
  .cat-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 22px;
    color: var(--fg);
  }
  .cat-card:hover {
    transform: translateY(-3px);
  }
  .cat-name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--primary);
  }
  .cat-count {
    font-size: 0.8rem;
    color: var(--fg-subtle);
  }
</style>
