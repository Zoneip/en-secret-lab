---
/** 分类总览 */
import { getAllPosts } from '../../lib/content/data'
import BaseLayout from '../../layouts/BaseLayout.astro'

import CategoryMap from '../../components/blog/CategoryMap.astro'

const posts = await getAllPosts()
const categories = [...new Set(posts.map((p) => p.category).filter(Boolean))]
---

<BaseLayout fillViewport title="分类" description="全站分类总览">
  <div class="page-enter container">
    <header class="page-head">
      <h1>分类</h1>
      <p>{categories.length} 个分类</p>
    </header>

    <CategoryMap posts={posts} />
  </div>
</BaseLayout>

<style>
  .page-head {
    padding: 40px 0 24px;
    text-align: center;
  }
  .page-head h1 {
    font-size: 2rem;
    margin-bottom: 6px;
  }
  .page-head p {
    color: var(--fg-subtle);
    font-size: 0.85rem;
  }
</style>
