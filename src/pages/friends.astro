---
/** 友链页:展示 + 申请登记(动态版实时,静态版 mailto 降级) */
import BaseLayout from '../layouts/BaseLayout.astro'
import EmptyState from '../components/ui/EmptyState.astro'
import { getSiteFriends } from '../lib/content/site-friends'

const friends = await getSiteFriends()
---

<BaseLayout title="友链" description="交换友链的伙伴们">
  <div class="page-enter container">
    <header class="page-head">
      <h1>友链</h1>
      <p>目前有 {friends.length} 位伙伴</p>
      <div class="page-actions">
        <button class="btn" data-open-apply>申请友链</button>
      </div>
    </header>

    {friends.length === 0 ? (
      <EmptyState title="还没有友链" description="想交换友链的话,点右上角申请吧" />
    ) : (
      <div class="grid">
        {friends.map((f) => (
          <a class="friend card" href={f.url} target="_blank" rel="noopener noreferrer">
            <span class="avatar" aria-hidden="true">
              {f.avatar ? (
                <img src={f.avatar} alt="" loading="lazy" />
              ) : (
                <span class="avatar-fallback">{f.name.slice(0, 1)}</span>
              )}
            </span>
            <span class="friend-info">
              <span class="name">{f.name}</span>
              <span class="desc">{f.description ?? '这位伙伴还没有简介'}</span>
            </span>
          </a>
        ))}
      </div>
    )}
  </div>

  <!-- 申请表单弹窗 -->
  <div class="apply-backdrop" data-apply-backdrop hidden>
    <form class="apply-card" data-apply-form>
      <div class="apply-head">
        <h2>申请友链</h2>
        <button type="button" class="apply-close" data-apply-close aria-label="关闭">×</button>
      </div>
      <p class="apply-tip">提交后等待主人审核,通过后会显示在这里。</p>
      <label class="apply-field">
        <span>站点名称 *</span>
        <input name="name" required placeholder="你的站点名" maxlength="30" />
      </label>
      <label class="apply-field">
        <span>站点链接 *</span>
        <input name="url" required placeholder="https://example.com" type="url" />
      </label>
      <label class="apply-field">
        <span>头像 URL</span>
        <input name="avatar" placeholder="https://…/avatar.png" type="url" />
      </label>
      <label class="apply-field">
        <span>一句话简介</span>
        <input name="description" maxlength="60" placeholder="这个站点是做什么的" />
      </label>
      <label class="apply-field">
        <span>联系邮箱</span>
        <input name="email" placeholder="用于审核通知(可选)" type="email" />
      </label>
      <p class="apply-error" data-apply-error></p>
      <button type="submit" class="btn apply-submit" data-apply-submit>提交申请</button>
    </form>
  </div>
</BaseLayout>

<script>
  const isServerRuntime = document.body.dataset.isServerRuntime
  const backdrop = document.querySelector<HTMLElement>('[data-apply-backdrop]')!
  const form = document.querySelector<HTMLFormElement>('[data-apply-form]')!

  // 静态版:申请降级为邮件
  document.querySelector('[data-open-apply]')?.addEventListener('click', () => {
    if (isServerRuntime === 'true') {
      backdrop.hidden = false
    } else {
      window.location.href =
        'mailto:?subject=友链申请&body=站点名称:%0A站点链接:%0A简介:'
    }
  })
  document.querySelector('[data-apply-close]')?.addEventListener('click', () => {
    backdrop.hidden = true
  })
  backdrop.addEventListener('click', (e) => {
    if (e.target === backdrop) backdrop.hidden = true
  })

  form?.addEventListener('submit', async (e) => {
    e.preventDefault()
    const error = document.querySelector<HTMLElement>('[data-apply-error]')!
    const submit = document.querySelector<HTMLButtonElement>('[data-apply-submit]')!
    error.textContent = ''
    submit.disabled = true
    const fd = new FormData(form)
    try {
      const res = await fetch('/api/friend-request', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: fd.get('name'),
          url: fd.get('url'),
          avatar: fd.get('avatar'),
          description: fd.get('description'),
          email: fd.get('email'),
        }),
      })
      const body = await res.json().catch(() => null)
      if (res.ok) {
        form.innerHTML = '<p class="apply-success">申请已提交,等主人审核通过后就会显示出来。</p>'
      } else {
        error.textContent = body?.error ?? '提交失败,请稍后再试'
      }
    } catch {
      error.textContent = '网络异常,请稍后再试'
    } finally {
      submit.disabled = false
    }
  })
</script>

<style>
  .page-head {
    padding: 40px 0 24px;
    text-align: center;
  }
  .page-actions {
    margin-top: 16px;
  }
  .apply-backdrop {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: rgba(20, 24, 34, 0.5);
    display: grid;
    place-items: center;
    padding: 20px;
  }
  .apply-backdrop[hidden] {
    display: none;
  }
  .apply-card {
    width: min(420px, 100%);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 24px;
    box-shadow: 0 24px 60px rgba(20, 26, 40, 0.3);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .apply-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .apply-head h2 {
    font-size: 1.15rem;
  }
  .apply-close {
    background: none;
    border: none;
    font-size: 1.4rem;
    color: var(--fg-subtle);
    cursor: pointer;
    line-height: 1;
  }
  .apply-tip {
    font-size: 0.8rem;
    color: var(--fg-subtle);
  }
  .apply-field {
    display: flex;
    flex-direction: column;
    gap: 5px;
    font-size: 0.8rem;
    color: var(--fg-muted);
  }
  .apply-field input {
    padding: 9px 12px;
    border: 1.5px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
    font-size: 0.9rem;
    font-family: var(--font-body);
    color: var(--fg);
  }
  .apply-field input:focus {
    outline: 2px solid var(--primary);
    outline-offset: -1px;
  }
  .apply-error {
    font-size: 0.8rem;
    color: var(--error);
    min-height: 1em;
  }
  .apply-success {
    font-size: 0.9rem;
    color: var(--success);
    text-align: center;
    padding: 24px 0;
  }
  .apply-submit {
    width: 100%;
    justify-content: center;
  }
  .page-head h1 {
    font-size: 2rem;
    margin-bottom: 6px;
  }
  .page-head p {
    color: var(--fg-subtle);
    font-size: 0.85rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 18px;
  }
  .friend {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px;
    color: var(--fg);
  }
  .friend:hover {
    transform: translateY(-3px);
  }
  .avatar {
    width: 52px;
    height: 52px;
    border-radius: 16px;
    overflow: hidden;
    flex-shrink: 0;
    background: var(--elevated);
    border: 1px solid var(--border);
    display: grid;
    place-items: center;
  }
  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .avatar-fallback {
    font-family: var(--font-display);
    color: var(--primary);
    font-size: 1.3rem;
  }
  .friend-info {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }
  .name {
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--primary);
  }
  .desc {
    font-size: 0.82rem;
    color: var(--fg-subtle);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
