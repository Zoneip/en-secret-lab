---
/** 友链页 */
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import EmptyState from '../components/ui/EmptyState.astro'

const friends = await getCollection('friends')
---

<BaseLayout title="友链" description="交换友链的伙伴们">
  <div class="page-enter">
    <header class="page-head">
      <h1>友链</h1>
      <p>目前有 {friends.length} 位伙伴</p>
    </header>

    {friends.length === 0 ? (
      <EmptyState title="还没有友链" description="想交换友链的话,留言给主人吧" />
    ) : (
      <div class="grid">
        {friends.map((f) => (
          <a class="friend card" href={f.data.url} target="_blank" rel="noopener noreferrer">
            <span class="avatar" aria-hidden="true">
              {f.data.avatar ? (
                <img src={f.data.avatar} alt="" loading="lazy" />
              ) : (
                <span class="avatar-fallback">{f.data.name.slice(0, 1)}</span>
              )}
            </span>
            <span class="friend-info">
              <span class="name">{f.data.name}</span>
              <span class="desc">{f.data.description ?? '这位伙伴还没有简介'}</span>
            </span>
          </a>
        ))}
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .page-head {
    padding: 40px 0 24px;
    text-align: center;
  }
  .page-head h1 {
    font-size: 2rem;
    margin-bottom: 6px;
  }
  .page-head p {
    color: var(--fg-subtle);
    font-size: 0.85rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 18px;
  }
  .friend {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px;
    color: var(--fg);
  }
  .friend:hover {
    transform: translateY(-3px);
  }
  .avatar {
    width: 52px;
    height: 52px;
    border-radius: 16px;
    overflow: hidden;
    flex-shrink: 0;
    background: var(--elevated);
    border: 1px solid var(--border);
    display: grid;
    place-items: center;
  }
  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .avatar-fallback {
    font-family: var(--font-display);
    color: var(--primary);
    font-size: 1.3rem;
  }
  .friend-info {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }
  .name {
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--primary);
  }
  .desc {
    font-size: 0.82rem;
    color: var(--fg-subtle);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
