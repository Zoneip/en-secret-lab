---
/** 关于页 v5:横向滚动单页 + 切屏切换全局主题(与栏目页同机制)
 *  无子页面/无 View Transitions/无滚轮劫持;当前屏主题唯一生效(壁纸/配色/顶部栏跟随)
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import OCScreen from '../components/about/OCScreen.astro'
import Mascot from '../components/mascot/Mascot.astro'
import { getSiteAbout, getSiteOcs } from '../lib/content/site-content'

const about = await getSiteAbout()
const ocs = (await getSiteOcs()).sort(
  (a, b) =>
    ['gray', 'yellow', 'purple', 'white'].indexOf(a.theme) -
    ['gray', 'yellow', 'purple', 'white'].indexOf(b.theme)
)
const screenThemes = ['', ...ocs.map((o) => o.theme)]
---

<BaseLayout title="关于" description="关于这个站点和它的主人" hideFooter>
  <div class="snap-wrap">
    <div class="snap-scroller" data-snap-scroller>
      <!-- 屏1:hero(默认主题) -->
      <section class="snap-section hero-screen" data-screen>
        <div class="hero-inner">
          {about && (
            <>
              <div class="hero-avatar-wrap">
                {about.avatar ? (
                  <img src={about.avatar} alt={about.nickname} class="hero-avatar" />
                ) : (
                  <div class="hero-mascots" data-motion-group="mascot" aria-hidden="true">
                    <Mascot role="furry" pixel={7} />
                    <Mascot role="boy" pixel={6} />
                  </div>
                )}
              </div>
              <p class="hero-nickname">{about.nickname}</p>
              {about.tagline && <p class="hero-tagline">{about.tagline}</p>}
              {about.intro.length > 0 && (
                <ul class="hero-intro">
                  {about.intro.map((line) => (
                    <li>{line}</li>
                  ))}
                </ul>
              )}
              {about.links.length > 0 && (
                <div class="hero-links">
                  {about.links.map((link) => (
                    <a class="chip" href={link.url} target="_blank" rel="noopener noreferrer">
                      {link.label}
                    </a>
                  ))}
                </div>
              )}
            </>
          )}
          <div class="hero-scroll-hint" aria-hidden="true">
            <span>左右滑动看看四位伙伴</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 6l-5 6 5 6M19 6l-5 6 5 6" /></svg>
          </div>
        </div>
      </section>

      <!-- 屏2-5:四个 OC(切屏时全局主题跟随) -->
      {ocs.map((oc, i) => (
        <OCScreen oc={oc} flip={i % 2 === 1} />
      ))}
    </div>

    <!-- 圆点导航 + 进度条 -->
    <nav class="about-dots" aria-label="页面导航">
      {screenThemes.map((_, i) => (
        <button class="about-dot" data-dot={i} aria-label={`第 ${i + 1} 屏`}></button>
      ))}
    </nav>
    <div class="about-track" aria-hidden="true">
      <div class="about-track-fill" data-track-fill></div>
    </div>
  </div>
</BaseLayout>

<style is:global>
  .snap-wrap {
    position: fixed;
    inset: 0;
    top: var(--header-h);
    bottom: 0;
  }
  .snap-scroller {
    height: 100%;
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .snap-scroller::-webkit-scrollbar {
    display: none;
  }
  .snap-section {
    min-height: 100%;
    flex: 0 0 100%;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow-y: auto;
    padding: 48px 56px 56px;
    visibility: hidden;
  }
  .snap-section.in-view {
    visibility: visible;
  }
  /* ===== hero 屏 ===== */
  .hero-screen {
    text-align: center;
  }
  .hero-inner {
    max-width: 640px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    animation: hero-in 0.6s var(--ease-soft) 0.1s both;
  }
  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .hero-avatar-wrap {
    display: flex;
    justify-content: center;
  }
  .hero-avatar {
    width: 132px;
    height: 132px;
    border-radius: 32px;
    object-fit: cover;
    border: 3px solid var(--surface);
    box-shadow: var(--shadow);
  }
  .hero-mascots {
    display: flex;
    gap: 2px;
    padding: 10px;
    border-radius: 20px;
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
  }
  .hero-nickname {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 3rem);
    color: var(--primary);
  }
  .hero-tagline {
    color: var(--fg-muted);
  }
  .hero-intro {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
    color: var(--fg);
    font-size: 0.92rem;
    padding: 0;
    margin: 0;
  }
  .hero-links {
    display: flex;
    gap: 8px;
    margin-top: 6px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .hero-scroll-hint {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    color: var(--fg-subtle);
    font-size: 0.8rem;
    margin-top: 24px;
    animation: hint-bob 2s ease-in-out infinite;
  }
  .hero-scroll-hint svg {
    width: 20px;
    height: 20px;
  }
  @keyframes hint-bob {
    0%,
    100% {
      transform: translateX(0);
    }
    50% {
      transform: translateX(6px);
    }
  }
  /* ===== 圆点 + 进度条 ===== */
  .about-dots {
    position: fixed;
    bottom: 44px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 12px;
    z-index: 20;
  }
  .about-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: none;
    background: var(--border-strong);
    cursor: pointer;
    transition: all 0.3s var(--ease-spring);
    opacity: 0.6;
  }
  .about-dot:hover {
    opacity: 1;
  }
  .about-dot.active {
    background: var(--primary);
    opacity: 1;
    transform: scale(1.4);
  }
  .about-track {
    position: fixed;
    bottom: 14px;
    left: 50%;
    transform: translateX(-50%);
    width: 44px;
    height: 3px;
    border-radius: 999px;
    background: var(--border);
    overflow: hidden;
    z-index: 20;
    opacity: 0.6;
  }
  .about-track-fill {
    height: 100%;
    width: 20%;
    border-radius: 999px;
    background: var(--primary);
    transition: transform 0.35s var(--ease-soft);
  }
  @media (max-width: 760px) {
    .snap-section {
      padding: 40px 24px 48px;
    }
    .hero-nickname {
      font-size: 2rem;
    }
    .about-dots {
      bottom: 18px;
    }
    .about-track {
      display: none;
    }
  }
</style>

<script is:inline define:vars={{ screenThemes }}>
  ;(function () {
    const scroller = document.querySelector('[data-snap-scroller]')
    const screens = [...document.querySelectorAll('[data-screen]')]
    if (!scroller || !screens.length) return

    let currentIdx = -1

    // 切屏 → 全局主题(与栏目页 forceTheme 同机制)
    function applyScreenTheme(idx) {
      if (idx === currentIdx) return
      currentIdx = idx
      const theme = screenThemes[idx] ?? ''
      const html = document.documentElement
      if (theme) {
        html.dataset.theme = theme
        html.dataset.forceTheme = theme
        html.dataset.themeLocked = 'true'
      } else {
        delete html.dataset.forceTheme
        const dark = html.dataset.mode === 'dark'
        html.dataset.theme = dark
          ? document.body.dataset.defaultThemeDark ?? 'purple'
          : document.body.dataset.defaultThemeLight ?? 'gray'
        html.dataset.themeLocked = 'false'
      }
      window.dispatchEvent(new CustomEvent('enlab:theme-change'))
    }

    scroller.addEventListener(
      'scroll',
      () => {
        requestAnimationFrame(() => {
          const idx = Math.round(scroller.scrollLeft / scroller.clientWidth)
          applyScreenTheme(Math.min(Math.max(0, idx), screens.length - 1))
        })
      },
      { passive: true }
    )

    // 滚轮翻页:垂直滚轮 → 横向平滑切屏;横向手势(触摸板)交还原生
    let wheelLock = false
    let wheelLockT = 0
    window.addEventListener(
      'wheel',
      (e) => {
        if (e.deltaX && !e.deltaY) return
        if (wheelLock || !e.deltaY) {
          e.preventDefault()
          return
        }
        e.preventDefault()
        wheelLock = true
        const cur = Math.round(scroller.scrollLeft / scroller.clientWidth)
        const next = Math.min(Math.max(0, cur + (e.deltaY > 0 ? 1 : -1)), screens.length - 1)
        scroller.scrollTo({ left: next * scroller.clientWidth, behavior: 'smooth' })
        window.clearTimeout(wheelLockT)
        wheelLockT = window.setTimeout(() => {
          wheelLock = false
        }, 700)
      },
      { passive: false }
    )

    // 屏外裁剪 + 当前屏激活
    const inViewIo = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          entry.target.classList.toggle('in-view', entry.isIntersecting)
          if (entry.isIntersecting && entry.intersectionRatio > 0.5) {
            entry.target.classList.add('active')
          } else if (entry.intersectionRatio < 0.1) {
            entry.target.classList.remove('active')
          }
        }
      },
      { threshold: [0, 0.1, 0.5, 0.9, 1] }
    )
    screens.forEach((s) => inViewIo.observe(s))

    // 圆点导航 + 进度条
    const dots = [...document.querySelectorAll('[data-dot]')]
    const trackFill = document.querySelector('[data-track-fill]')
    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        scroller.scrollTo({ left: i * scroller.clientWidth, behavior: 'smooth' })
      })
    })
    const updateProgress = () => {
      const idx = Math.round(scroller.scrollLeft / scroller.clientWidth)
      dots.forEach((d, i) => d.classList.toggle('active', i === idx))
      const max = scroller.scrollWidth - scroller.clientWidth
      const ratio = max > 0 ? scroller.scrollLeft / max : 0
      if (trackFill) trackFill.style.transform = `translateX(${ratio * 400}%)`
    }
    scroller.addEventListener('scroll', updateProgress, { passive: true })

    // 打字机:进入视口播放一次
    const TYPE_SPEED = { slow: 95, normal: 55, fast: 28 }
    const typingIo = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue
          const q = entry.target
          if (q.dataset.typed === '1') continue
          q.dataset.typed = '1'
          const text = q.querySelector('.quote-text')
          if (!text) continue
          const full = text.dataset.quoteFull ?? ''
          const speed = TYPE_SPEED[q.dataset.quoteSpeed] ?? 55
          text.textContent = ''
          let i = 0
          const timer = window.setInterval(() => {
            i++
            text.textContent = `「${full.slice(0, i)}」`
            if (i >= full.length) window.clearInterval(timer)
          }, speed)
        }
      },
      { threshold: 0.4 }
    )
    screens.forEach((s) => {
      const q = s.querySelector('[data-quote-effect="typing"]')
      if (q) typingIo.observe(q)
    })

    applyScreenTheme(0)
    updateProgress()
  })()
</script>
