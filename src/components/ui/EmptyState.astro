---
/** 空状态:带像素吉祥物的可爱提示 */
import Mascot from '../mascot/Mascot.astro'

interface Props {
  title?: string
  description?: string
}

const { title = '这里空空如也', description = '还没有内容,过阵子再来看看吧' } = Astro.props
---

<div class="empty-state card">
  <div class="empty-mascot">
    <Mascot role="furry" pixel={6} />
  </div>
  <p class="empty-title">{title}</p>
  <p class="empty-desc">{description}</p>
  <a class="btn btn-ghost" href="/">回首页</a>
</div>

<style>
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding: 56px 24px;
    text-align: center;
  }
  .empty-mascot {
    opacity: 0.9;
    animation: bob 3s ease-in-out infinite;
  }
  @keyframes bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-6px);
    }
  }
  .empty-title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    color: var(--fg);
  }
  .empty-desc {
    font-size: 0.9rem;
    color: var(--fg-subtle);
  }
</style>
