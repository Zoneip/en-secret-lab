---
/**
 * 文章编辑器:frontmatter 表单 + Markdown 正文
 * /admin/posts/new 新建 | /admin/posts/[slug] 编辑
 */
import { isServer } from '../../lib/utils'
import AdminLayout from '../../layouts/AdminLayout.astro'

export const prerender = !isServer

const isNew = Astro.url.pathname.endsWith('/new')
const slug = isNew ? undefined : Astro.params.slug
---

<AdminLayout title={isNew ? '写新文章' : '编辑文章'} active="posts">
  <form class="editor" data-editor-form data-slug={slug}>
    <div class="card meta-card">
      <div class="row">
        <div class="field span-2">
          <label for="e-title">标题 *</label>
          <input type="text" id="e-title" data-field="title" required placeholder="文章标题" />
        </div>
      </div>
      <div class="row">
        <div class="field">
          <label for="e-slug">slug *</label>
          <input type="text" id="e-slug" data-field="slug" required pattern="[a-z0-9-]+" placeholder="my-post" />
        </div>
        <div class="field">
          <label for="e-category">分类</label>
          <input type="text" id="e-category" data-field="category" value="随笔" />
        </div>
      </div>
      <div class="row">
        <div class="field">
          <label for="e-date">发布日期</label>
          <input type="date" id="e-date" data-field="pubDate" />
        </div>
        <div class="field">
          <label for="e-updated">更新日期(可选)</label>
          <input type="date" id="e-updated" data-field="updatedDate" />
        </div>
      </div>
      <div class="field">
        <label for="e-tags">标签(逗号分隔)</label>
        <input type="text" id="e-tags" data-field="tags" placeholder="furry, 随笔" />
      </div>
      <div class="field">
        <label for="e-desc">摘要</label>
        <textarea id="e-desc" data-field="description" rows="2"></textarea>
      </div>
      <div class="checks">
        <label class="check"><input type="checkbox" data-field="draft" /> 草稿(不发布)</label>
        <label class="check"><input type="checkbox" data-field="featured" /> 精选</label>
      </div>
    </div>

    <div class="card body-card">
      <div class="field">
        <label for="e-body">正文(Markdown)</label>
        <textarea id="e-body" data-field="body" rows="20" placeholder="# 开始写作…"></textarea>
      </div>
    </div>

    <div class="editor-actions">
      <a class="btn" href="/admin/posts">返回列表</a>
      <button type="button" class="btn danger-btn" data-delete hidden>删除</button>
      <span class="spacer"></span>
      <span class="save-hint">Ctrl + S 保存</span>
      <button type="submit" class="btn btn-primary" data-save>保存</button>
    </div>
  </form>
</AdminLayout>

<script>
  interface PostFull {
    slug: string
    title: string
    description?: string
    pubDate: string
    updatedDate?: string
    category: string
    tags: string[]
    draft: boolean
    featured: boolean
    body: string
  }

  const form = document.querySelector<HTMLFormElement>('[data-editor-form]')!
  const slug = form.dataset.slug!
  const isNew = location.pathname.endsWith('/new')

  function f(name: string): HTMLInputElement | HTMLTextAreaElement {
    return form.querySelector(`[data-field="${name}"]`)!
  }

  if (!isNew) {
    const d: { ok: boolean; draft: PostFull } = await fetch(`/admin/api/posts/${slug}`).then((r) => r.json())
    if (!d.ok) {
      location.href = '/admin/posts'
    } else {
      f('title').value = d.draft.title
      f('slug').value = d.draft.slug
      f('category').value = d.draft.category
      f('pubDate').value = d.draft.pubDate
      f('updatedDate').value = d.draft.updatedDate ?? ''
      f('tags').value = d.draft.tags.join(', ')
      f('description').value = d.draft.description ?? ''
      ;(f('draft') as HTMLInputElement).checked = d.draft.draft
      ;(f('featured') as HTMLInputElement).checked = d.draft.featured
      f('body').value = d.draft.body
      document.querySelector<HTMLElement>('[data-delete]')!.hidden = false
    }
  } else {
    f('pubDate').value = new Date().toISOString().slice(0, 10)
  }

  function collect(): Partial<PostFull> {
    return {
      title: f('title').value.trim(),
      slug: f('slug').value.trim(),
      category: f('category').value.trim() || '随笔',
      pubDate: f('pubDate').value,
      updatedDate: f('updatedDate').value || undefined,
      tags: f('tags')
        .value.split(/[,，]/)
        .map((t) => t.trim())
        .filter(Boolean),
      description: f('description').value.trim() || undefined,
      draft: (f('draft') as HTMLInputElement).checked,
      featured: (f('featured') as HTMLInputElement).checked,
      body: f('body').value,
    }
  }

  async function save(): Promise<boolean> {
    const payload = collect()
    const res = await fetch(isNew ? '/admin/api/posts' : `/admin/api/posts/${slug}`, {
      method: isNew ? 'POST' : 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    })
    if (!res.ok) {
      window.toast((await res.json()).error ?? '保存失败', true)
      return false
    }
    window.toast('已保存')
    return true
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault()
    const ok = await save()
    if (ok && isNew) {
      const d = await fetch('/admin/api/posts').then((r) => r.json())
      location.href = `/admin/posts/${d.posts[0].slug}`
    }
  })

  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 's') {
      e.preventDefault()
      save()
    }
  })

  document.querySelector('[data-delete]')!.addEventListener('click', async () => {
    if (!window.confirm('确认删除这篇文章?此操作不可恢复')) return
    const res = await fetch(`/admin/api/posts/${slug}`, { method: 'DELETE' })
    if (res.ok) {
      window.toast('已删除')
      location.href = '/admin/posts'
    } else {
      window.toast((await res.json()).error ?? '删除失败', true)
    }
  })
</script>

<style>
  .editor {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .meta-card {
    padding: 20px 22px;
  }
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .span-2 {
    grid-column: span 2;
  }
  .checks {
    display: flex;
    gap: 20px;
    margin-top: 4px;
  }
  .check {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: var(--a-fg-muted);
    cursor: pointer;
  }
  .check input {
    accent-color: var(--a-primary);
  }
  .body-card {
    padding: 20px 22px;
  }
  #e-body {
    font-family: ui-monospace, 'JetBrains Mono', monospace;
    font-size: 13px;
    line-height: 1.7;
    resize: vertical;
  }
  .editor-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .spacer {
    flex: 1;
  }
  .save-hint {
    font-size: 11px;
    color: var(--a-fg-subtle);
  }
  .danger-btn {
    color: #d9534f;
    border-color: #f0c4c2;
  }
  .danger-btn:hover {
    border-color: #d9534f;
    color: #d9534f;
  }
  @media (max-width: 640px) {
    .row {
      grid-template-columns: 1fr;
    }
    .span-2 {
      grid-column: span 1;
    }
  }
</style>
