---
/**
 * 主题切换器:浮动按钮 + 面板
 * 访客能力(已确认权限):切换配色主题 + 深浅模式,存 localStorage
 */
import { themes } from '../../lib/theme/presets'
---

<div class="theme-switcher" data-theme-switcher>
  <button class="fab" data-fab aria-label="切换主题" aria-expanded="false" aria-haspopup="dialog">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.39 5.39 0 0 1-4.4 2.26 5.4 5.4 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1z" />
    </svg>
  </button>

  <div class="panel" role="dialog" aria-label="主题设置" hidden>
    <p class="panel-title">换上喜欢的配色</p>

    <div class="theme-grid">
      {
        themes.map((t) => (
          <button
            class="theme-card"
            data-theme-id={t.id}
            aria-pressed="false"
          >
            <span class="theme-preview" aria-hidden="true">
              <i style="background:{t.palette.light.primary}"></i>
              <i style="background:{t.palette.light.accent}"></i>
              <i style="background:{t.palette.light.bg}"></i>
            </span>
            <span class="theme-name">{t.name}</span>
          </button>
        ))
      }
    </div>

    <fieldset class="mode-group">
      <legend>显示模式</legend>
      <div class="mode-segmented" role="radiogroup" aria-label="显示模式">
        <button type="button" role="radio" data-mode="light" aria-checked="false">浅色</button>
        <button type="button" role="radio" data-mode="dark" aria-checked="false">深色</button>
        <button type="button" role="radio" data-mode="system" aria-checked="false">跟随系统</button>
      </div>
    </fieldset>

    <p class="panel-hint">选择会保存在你的浏览器里</p>
  </div>
</div>

<script is:inline data-astro-rerun>
  ;(function () {
    if (window.__themeSwitcherCleanup) window.__themeSwitcherCleanup()
    const root = document.querySelector('[data-theme-switcher]')
    if (!root) return
    const fab = root.querySelector('[data-fab]')
    const panel = root.querySelector('.panel')
    const themeCards = root.querySelectorAll('.theme-card')
    const modeButtons = root.querySelectorAll('[data-mode]')
    const PREFS_KEY = 'enlab:prefs'

    function readPrefs() {
      try {
        const raw = localStorage.getItem(PREFS_KEY)
        if (raw) return JSON.parse(raw)
      } catch {
        /* ignore */
      }
      return { theme: undefined, themeLocked: false, mode: 'system' }
    }
    function modeIsDark(mode) {
      return mode === 'dark' || (mode === 'system' && matchMedia('(prefers-color-scheme: dark)').matches)
    }
    function applyPrefs(prefs) {
      const forced = document.documentElement.dataset.forceTheme
      const dark = modeIsDark(prefs.mode)
      const mode = dark ? 'dark' : 'light'
      const lightDefault = document.body.dataset.defaultThemeLight ?? 'gray'
      const darkDefault = document.body.dataset.defaultThemeDark ?? 'purple'
      const theme = forced || (prefs.themeLocked && prefs.theme) || (dark ? darkDefault : lightDefault)
      document.documentElement.dataset.theme = theme
      document.documentElement.dataset.mode = mode
      document.documentElement.dataset.modePref = prefs.mode
      document.documentElement.dataset.themeLocked = String(forced || prefs.themeLocked)
      window.dispatchEvent(new CustomEvent('enlab:theme-change'))
      themeCards.forEach((card) => {
        card.setAttribute('aria-pressed', String(card.dataset.themeId === theme))
        card.classList.toggle('selected', card.dataset.themeId === theme)
      })
      modeButtons.forEach((btn) => {
        const isActive = btn.dataset.mode === prefs.mode
        btn.setAttribute('aria-checked', String(isActive))
        btn.classList.toggle('selected', isActive)
      })
    }
    function savePrefs(prefs) {
      try {
        localStorage.setItem(PREFS_KEY, JSON.stringify(prefs))
      } catch {
        /* ignore */
      }
    }
    function setTheme(theme) {
      const prefs = readPrefs()
      prefs.theme = theme
      prefs.themeLocked = true
      savePrefs(prefs)
      applyPrefs(prefs)
    }
    function setMode(mode) {
      const prefs = readPrefs()
      prefs.mode = mode
      if (!prefs.themeLocked) prefs.theme = undefined
      savePrefs(prefs)
      applyPrefs(prefs)
    }
    function lockSwitcher() {
      const locked = Boolean(document.documentElement.dataset.forceTheme)
      fab.hidden = locked
      if (locked) panel.hidden = true
    }
    function togglePanel(force) {
      const open = force ?? panel.hidden
      panel.hidden = !open
      fab.setAttribute('aria-expanded', String(open))
    }

    const onFab = () => togglePanel()
    const cardHandlers = []
    themeCards.forEach((card) => {
      const h = () => setTheme(card.dataset.themeId)
      cardHandlers.push([card, h])
      card.addEventListener('click', h)
    })
    const modeHandlers = []
    modeButtons.forEach((btn) => {
      const h = () => setMode(btn.dataset.mode)
      modeHandlers.push([btn, h])
      btn.addEventListener('click', h)
    })
    const onKey = (e) => {
      if (e.key === 'Escape' && !panel.hidden) togglePanel(false)
    }
    const onDocClick = (e) => {
      if (!panel.hidden && !root.contains(e.target)) togglePanel(false)
    }
    const onMedia = () => applyPrefs(readPrefs())

    fab.addEventListener('click', onFab)
    document.addEventListener('keydown', onKey)
    document.addEventListener('click', onDocClick)
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', onMedia)
    lockSwitcher()
    applyPrefs(readPrefs())

    window.__themeSwitcherCleanup = () => {
      fab.removeEventListener('click', onFab)
      cardHandlers.forEach(([c, h]) => c.removeEventListener('click', h))
      modeHandlers.forEach(([b, h]) => b.removeEventListener('click', h))
      document.removeEventListener('keydown', onKey)
      document.removeEventListener('click', onDocClick)
      matchMedia('(prefers-color-scheme: dark)').removeEventListener('change', onMedia)
      window.__themeSwitcherCleanup = undefined
    }
  })()
</script>

<style>
  .theme-switcher {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 40;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 12px;
  }
  .fab {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: none;
    cursor: pointer;
    display: grid;
    place-items: center;
    background: var(--primary);
    color: var(--primary-fg);
    box-shadow: 0 6px 20px color-mix(in srgb, var(--primary) 45%, transparent);
    transition: transform 0.25s var(--ease-spring), box-shadow 0.25s var(--ease-soft);
  }
  .fab:hover {
    transform: translateY(-3px) rotate(-8deg);
  }
  .panel {
    width: min(320px, calc(100vw - 40px));
    padding: 16px;
    border-radius: 18px;
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    animation: panel-in 0.25s var(--ease-spring);
  }
  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.97);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .panel-title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--fg);
    margin-bottom: 12px;
  }
  .theme-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
  }
  .theme-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 10px 4px 8px;
    border: 2px solid var(--border);
    border-radius: 14px;
    background: var(--surface);
    cursor: pointer;
    transition: border-color 0.2s, transform 0.2s var(--ease-spring);
  }
  .theme-card:hover {
    transform: translateY(-2px);
  }
  .theme-card.selected {
    border-color: var(--primary);
    background: var(--primary-soft);
  }
  .theme-preview {
    display: flex;
    gap: 3px;
  }
  .theme-preview i {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--fg) 15%, transparent);
  }
  .theme-name {
    font-size: 0.78rem;
    color: var(--fg-muted);
  }
  .theme-card.selected .theme-name {
    color: var(--primary);
    font-weight: 500;
  }
  .mode-group {
    border: none;
    margin-top: 14px;
  }
  .mode-group legend {
    font-size: 0.8rem;
    color: var(--fg-subtle);
    margin-bottom: 6px;
  }
  .mode-segmented {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px;
    padding: 4px;
    border-radius: var(--radius-pill);
    background: var(--elevated);
  }
  .mode-segmented button {
    border: none;
    padding: 6px 0;
    border-radius: var(--radius-pill);
    font-size: 0.85rem;
    background: transparent;
    color: var(--fg-muted);
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }
  .mode-segmented button.selected {
    background: var(--surface);
    color: var(--fg);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
  }
  .panel-hint {
    margin-top: 10px;
    font-size: 0.72rem;
    color: var(--fg-subtle);
  }
</style>
