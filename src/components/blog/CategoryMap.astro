---
/** 分类思维导图:Mind Elixir 数据驱动(分类→系列→文章),主题配色、深浅模式感知、点击跳转 */
import { aggregateByKey } from '../../lib/content/taxonomy'

interface Props {
  posts: Array<{
    slug: string
    title: string
    category?: string
    series?: string
    pubDate: Date
  }>
}

const { posts } = Astro.props
const categories = aggregateByKey(posts, 'category')

interface NodeData {
  topic: string
  id: string
  hyperLink?: string
  children?: NodeData[]
}

const maps: Array<{ id: string; root: NodeData }> = categories.map((c) => {
  const catPosts = posts.filter((p) => p.category === c.name)
  const seriesMap = new Map<string, typeof catPosts>()
  for (const p of catPosts) {
    if (p.series) {
      if (!seriesMap.has(p.series)) seriesMap.set(p.series, [])
      seriesMap.get(p.series)!.push(p)
    }
  }
  const children: NodeData[] = []
  for (const [name, ps] of seriesMap) {
    children.push({
      topic: name,
      id: `s-${c.name}-${name}`,
      children: ps.map((p) => ({
        topic: p.title,
        id: `p-${p.slug}`,
        hyperLink: `/blog/${p.slug}`,
      })),
    })
  }
  for (const p of catPosts.filter((x) => !x.series)) {
    children.push({ topic: p.title, id: `p-${p.slug}`, hyperLink: `/blog/${p.slug}` })
  }
  return {
    id: `map-${c.name}`,
    root: { topic: `${c.name} (${c.count})`, id: `c-${c.name}`, children },
  }
})
const mapsJson = JSON.stringify(maps)
---

<div class="mindmap-wrap" data-mindmaps>
  {maps.length === 0 && <p class="empty">还没有分类</p>}
  {maps.map((m) => (
    <div class="mindmap-card" data-mindmap={m.id}>
      <div class="map-canvas" data-canvas></div>
    </div>
  ))}
</div>
<script type="application/json" id="mindmap-data" set:html={mapsJson}></script>

<style>
  .mindmap-wrap {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .mindmap-wrap .empty {
    text-align: center;
    color: var(--fg-subtle);
    padding: 40px 0;
  }
  .mindmap-card {
    border: 1px solid var(--border);
    border-radius: 20px;
    background: var(--surface);
    box-shadow: var(--shadow);
    padding: 10px;
    overflow: hidden;
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.6s var(--ease-soft), transform 0.6s var(--ease-soft);
  }
  .mindmap-card.grown {
    opacity: 1;
    transform: none;
  }
  .map-canvas {
    height: clamp(280px, 46vh, 440px);
    width: 100%;
  }
  /* Mind Elixir 内部:融入主题 */
  .mindmap-card .mind-elixir {
    --main-color: var(--primary);
    --main-bgcolor: var(--border-strong);
    --color: var(--fg);
    --bgcolor: var(--surface);
    --panel-color: 255, 255, 255;
    --panel-bgcolor: 45, 45, 55;
  }
  .mindmap-card .mind-elixir .minder-editor,
  .mindmap-card .mind-elixir .minder-view {
    background: transparent !important;
  }
  .mindmap-card .mind-elixir .minder-node {
    cursor: pointer;
  }
  @media (prefers-reduced-motion: reduce) {
    .mindmap-card {
      transition: none;
    }
  }
</style>

<script>
  import MindElixir from 'mind-elixir'
  import 'mind-elixir/style.css'

  const cards = [...document.querySelectorAll('[data-mindmap]')]
  const maps: Array<{ id: string; root: { topic: string; id: string; children?: unknown[] } }> = JSON.parse(
    document.querySelector('#mindmap-data')?.textContent ?? '[]'
  )
  if (cards.length && maps.length) {
    const minds: MindElixir[] = []

    const cssVars = () => {
      const root = getComputedStyle(document.documentElement)
      const p = root.getPropertyValue('--primary').trim()
      const b = root.getPropertyValue('--border-strong').trim()
      const fg = root.getPropertyValue('--fg').trim()
      const bg = root.getPropertyValue('--surface').trim()
      return {
        '--main-color': p,
        '--main-bgcolor': b,
        '--color': fg,
        '--bgcolor': bg,
        '--panel-color': '255, 255, 255',
        '--panel-bgcolor': '45, 45, 55',
      }
    }

    cards.forEach((card) => {
      const id = card.getAttribute('data-mindmap')
      const data = maps.find((m) => m.id === id)
      if (!data) return
      const el = card.querySelector('[data-canvas]')
      const mind = new MindElixir({
        el: el as HTMLElement,
        direction: MindElixir.RIGHT,
        draggable: false,
        contextMenu: false,
        toolBar: false,
        keypress: false,
        theme: {
          name: 'theme',
          palette: [cssVars()['--main-color']],
          cssVar: cssVars(),
        },
      })
      mind.init({ nodeData: data.root } as never)
      minds.push(mind)
    })

    // 深浅模式切换:重设主题
    window.addEventListener('enlab:theme-change', () => {
      minds.forEach((mind) => {
        if (typeof mind.changeTheme === 'function') {
          mind.changeTheme({ name: 'theme', palette: [cssVars()['--main-color']], cssVar: cssVars() })
        }
      })
    })
  }

  // 生长浮现(进入视口)
  const io = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.classList.add('grown')
          io.unobserve(entry.target)
        }
      }
    },
    { threshold: 0.15 }
  )
  cards.forEach((c) => io.observe(c))
</script>
