---
/** 分类总览:像素分类系列卡(卡头 + 系列分组 + 文章列表),纯 SSR 零 JS */
import { aggregateByKey } from '../../lib/content/taxonomy'

interface Props {
  posts: Array<{
    slug: string
    title: string
    category?: string
    series?: string
    pubDate: Date
  }>
}

const { posts } = Astro.props
const categories = aggregateByKey(posts, 'category')
const fmtDate = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`

interface SeriesGroup {
  name: string
  posts: typeof posts
}

const trees: Array<{ name: string; count: number; series: SeriesGroup[]; loose: typeof posts }> = categories.map((c) => {
  const catPosts = posts.filter((p) => p.category === c.name)
  const seriesMap = new Map<string, typeof catPosts>()
  for (const p of catPosts) {
    if (p.series) {
      if (!seriesMap.has(p.series)) seriesMap.set(p.series, [])
      seriesMap.get(p.series)!.push(p)
    }
  }
  return {
    name: c.name,
    count: c.count,
    series: [...seriesMap.entries()].map(([name, ps]) => ({ name, posts: ps })),
    loose: catPosts.filter((p) => !p.series),
  }
})
---

<div class="cat-wall">
  {trees.length === 0 && <p class="empty">还没有分类</p>}
  {trees.map((tree) => (
    <section class="cat-card">
      <a class="cat-head" href={`/categories/${encodeURIComponent(tree.name)}`}>
        <span class="cat-name">{tree.name}</span>
        <span class="cat-count">{tree.count} 篇</span>
      </a>
      <div class="cat-body">
        {tree.series.map((s) => (
          <div class="series">
            <div class="series-name">
              <span class="series-mark" aria-hidden="true"></span>
              {s.name}
            </div>
            <ul class="post-list">
              {s.posts.map((p) => (
                <li>
                  <a class="post-link" href={`/blog/${p.slug}`}>
                    <span class="post-date">{fmtDate(p.pubDate)}</span>
                    <span class="post-title">{p.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
        {tree.loose.length > 0 && (
          <ul class="post-list">
            {tree.loose.map((p) => (
              <li>
                <a class="post-link" href={`/blog/${p.slug}`}>
                  <span class="post-date">{fmtDate(p.pubDate)}</span>
                  <span class="post-title">{p.title}</span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
  ))}
</div>

<style>
  .cat-wall {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .cat-wall .empty {
    text-align: center;
    color: var(--fg-subtle);
    padding: 40px 0;
  }
  .cat-card {
    border: 1.5px solid var(--border-strong);
    border-radius: 16px;
    background: var(--surface);
    box-shadow: var(--shadow);
    overflow: hidden;
    transition: transform 0.2s var(--ease-spring), box-shadow 0.2s;
  }
  .cat-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 22px color-mix(in srgb, var(--primary) 16%, transparent);
  }
  .cat-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 22px;
    background: linear-gradient(90deg, color-mix(in srgb, var(--primary) 12%, transparent), transparent 60%);
    border-bottom: 1.5px solid var(--border);
    text-decoration: none;
  }
  .cat-name {
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--primary);
  }
  .cat-count {
    font-size: 0.78rem;
    font-family: var(--font-mono);
    color: var(--fg-muted);
    background: var(--primary-soft);
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    padding: 2px 12px;
  }
  .cat-body {
    padding: 16px 22px 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .series-name {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--primary);
    margin-bottom: 8px;
  }
  .series-mark {
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--primary);
    transform: rotate(45deg);
  }
  .post-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
  }
  .post-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.88rem;
    color: var(--fg);
    text-decoration: none;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--elevated);
    padding: 7px 14px;
    max-width: 320px;
    transition: border-color 0.2s, color 0.2s, transform 0.2s;
  }
  .post-link:hover {
    border-color: var(--primary);
    color: var(--primary);
    transform: translateY(-1px);
  }
  .post-date {
    font-size: 0.68rem;
    font-family: var(--font-mono);
    color: var(--fg-subtle);
    flex-shrink: 0;
  }
  .post-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  @media (max-width: 640px) {
    .cat-head {
      padding: 14px 16px;
    }
    .cat-body {
      padding: 14px 16px 18px;
    }
    .post-link {
      max-width: 100%;
    }
  }
</style>
