---
/** 标签云:wordcloud2 Canvas 词云(权重布局、主题配色、深浅模式感知、点击跳转) */
import { aggregateByKey } from '../../lib/content/taxonomy'

interface Props {
  posts: Array<{ tags?: string[] }>
}

const { posts } = Astro.props
const tags = aggregateByKey(posts, 'tags').slice(0, 40)
const list = tags.map((t) => [t.name, t.count] as [string, number])
---

<div class="wordcloud-wrap" data-wordcloud>
  {tags.length === 0 ? (
    <p class="empty">还没有标签</p>
  ) : (
    <canvas class="wordcloud-canvas"></canvas>
  )}
</div>

<style>
  .wordcloud-wrap {
    position: relative;
    width: 100%;
    height: clamp(340px, 60vh, 560px);
  }
  .wordcloud-wrap .empty {
    display: grid;
    place-items: center;
    height: 100%;
    color: var(--fg-subtle);
  }
  .wordcloud-canvas {
    display: block;
    width: 100%;
    height: 100%;
    cursor: pointer;
  }
</style>

<script is:inline define:vars={{ list }}>
  ;(function () {
    const wrap = document.querySelector('[data-wordcloud]')
    const canvas = wrap?.querySelector('canvas')
    if (!wrap || !canvas || !list.length) return

    let cloud = null

    function themeColors() {
      const cs = getComputedStyle(document.documentElement)
      const mode = document.documentElement.dataset.mode
      const p = cs.getPropertyValue('--primary').trim() || (mode === 'dark' ? '#e8a8be' : '#5c677d')
      const a = cs.getPropertyValue('--accent').trim() || (mode === 'dark' ? '#b9a6f5' : '#8b5cf6')
      const m = cs.getPropertyValue('--fg-muted').trim() || (mode === 'dark' ? '#b4a0ae' : '#8e7480')
      return { p, a, m }
    }

    function paint() {
      if (cloud) {
        cloud.stop()
        cloud = null
      }
      const w = wrap.clientWidth
      const h = wrap.clientHeight
      if (w < 60 || h < 60) return
      canvas.width = w * 2
      canvas.height = h * 2
      const { p, a, m } = themeColors()
      const palette = [p, a, m, p, a]
      const weight = list.map(([, n]) => n)
      const maxW = Math.max(...weight)
      cloud = window.WordCloud(canvas, {
        list,
        gridSize: 8,
        weightFactor: (n) => Math.max(16, Math.min(64, (n / maxW) * 52)),
        fontFamily: "'ZCOOL KuaiLe','Noto Sans SC',sans-serif",
        color: (w2, weight) => palette[(weight - 1) % palette.length],
        rotateRatio: 0,
        minSize: 0.001,
        weightMode: 'size',
        backgroundColor: 'rgba(0,0,0,0)',
        shrinkToFit: true,
        shape: 'circle',
        hover: () => {
          canvas.style.cursor = 'pointer'
        },
        click: (item) => {
          const name = item?.value ?? item?.[0]
          if (name) window.location.href = `/tags/${encodeURIComponent(String(name))}`
        },
      })
    }

    const draw = () => {
      requestAnimationFrame(paint)
    }
    window.addEventListener('resize', draw)
    window.addEventListener('enlab:theme-change', draw)
    draw()
  })()
</script>
