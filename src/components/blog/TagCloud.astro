---
/** 标签墙:像素风格,权重 3 档(大/中/小),纯 CSS 零 JS,SSR 直出 */
import { aggregateByKey } from '../../lib/content/taxonomy'

interface Props {
  posts: Array<{ tags?: string[] }>
  /** 最大标签字号(rem),默认为 1.45 */
  maxSize?: number
}

const { posts, maxSize = 1.45 } = Astro.props
const tags = aggregateByKey(posts, 'tags')
const max = Math.max(1, ...tags.map((t) => t.count))

// 3 档:权重 >= 2/3 为大,>= 1/3 为中,其余小
const tier = (count: number) =>
  count / max >= 0.66 ? 'lg' : count / max >= 0.33 ? 'md' : 'sm'
---

<div class="tag-wall" style={`--tag-max-size: ${maxSize}rem;`}>
  {tags.length === 0 && <p class="empty">还没有标签</p>}
  {
    tags.map((t) => (
      <a
        href={`/tags/${encodeURIComponent(t.name)}`}
        class={`tag-chip ${tier(t.count)}`}
        title={`${t.name} · ${t.count} 篇`}
      >
        {t.name}
        <span class="tag-count">{t.count}</span>
      </a>
    ))
  }
</div>

<style>
  .tag-wall {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 8px 0;
  }
  .tag-wall .empty {
    width: 100%;
    text-align: center;
    color: var(--fg-subtle);
    padding: 40px 0;
  }
  /* 像素胶囊:硬边 + 深色描边 + 暗角(像素 3D 感) */
  .tag-chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-display);
    text-decoration: none;
    border: 1.5px solid var(--border-strong);
    border-radius: 8px;
    box-shadow:
      inset -3px -3px 0 0 color-mix(in srgb, var(--primary) 22%, transparent),
      inset 3px 3px 0 0 color-mix(in srgb, #ffffff 55%, transparent);
    transition:
      transform 0.2s var(--ease-spring),
      box-shadow 0.2s,
      border-color 0.2s,
      color 0.2s;
  }
  .tag-chip:hover {
    transform: translateY(-2px);
    border-color: var(--primary);
    color: var(--primary);
    box-shadow:
      inset -3px -3px 0 0 color-mix(in srgb, var(--primary) 35%, transparent),
      inset 3px 3px 0 0 color-mix(in srgb, #ffffff 70%, transparent),
      0 4px 12px color-mix(in srgb, var(--primary) 22%, transparent);
  }
  .tag-chip.lg {
    font-size: var(--tag-max-size, 1.45rem);
    padding: 10px 20px;
    background: var(--primary);
    color: var(--primary-fg, #fff);
    border-color: color-mix(in srgb, var(--primary) 75%, #000);
  }
  .tag-chip.lg .tag-count {
    background: color-mix(in srgb, var(--primary-fg, #fff) 22%, transparent);
    color: inherit;
  }
  .tag-chip.md {
    font-size: 1.05rem;
    padding: 7px 15px;
    background: var(--primary-soft);
    color: var(--primary);
  }
  .tag-chip.sm {
    font-size: 0.86rem;
    padding: 5px 12px;
    background: color-mix(in srgb, var(--surface) 72%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: var(--fg-muted);
    border-color: color-mix(in srgb, var(--border-strong) 70%, transparent);
  }
  .tag-count {
    font-size: 0.62em;
    font-family: var(--font-mono);
    background: var(--border);
    border-radius: 6px;
    padding: 1px 6px;
    color: var(--fg-muted);
    line-height: 1.4;
  }
  @media (max-width: 640px) {
    .tag-chip.lg {
      font-size: calc(var(--tag-max-size, 1.45rem) * 0.83);
    }
  }
</style>
