---
/** 像素爪印分隔线:重复拼接的小爪印排 */
import { getTheme } from '../../lib/theme/presets'
import { PAW, paletteFor } from './art'

interface Props {
  theme?: string
  pixel?: number
}

const { theme = 'gray', pixel = 2 } = Astro.props
const preset = getTheme(theme)
const palette = paletteFor(preset.mascot)

let cells = ''
for (let y = 0; y < PAW.height; y++) {
  const row = PAW.rows[y]
  for (let x = 0; x < row.length; x++) {
    const ch = row[x]
    const fill = {
      '1': palette.primary,
      '2': palette.secondary,
      '3': palette.light,
      '4': palette.dark,
      '5': palette.eye,
      f: palette.skin,
      F: palette.skinShadow,
      w: palette.white,
    }[ch]
    if (!fill) continue
    cells += `<rect x="${x * pixel}" y="${y * pixel}" width="${pixel}" height="${pixel}" fill="${fill}"/>`
  }
}
const width = PAW.width * pixel
const height = PAW.height * pixel
const patternId = `paw-pattern-${crypto.randomUUID()}`
---

<div class="pixel-divider" role="presentation">
  <svg
    width="100%"
    height={height * 1.5}
    shape-rendering="crispEdges"
    preserveAspectRatio="xMidYMid meet"
    aria-hidden="true"
  >
    <pattern
      id={patternId}
      width={width * 3}
      height={height * 2}
      patternUnits="userSpaceOnUse"
    >
      <g set:html={cells} transform={`translate(0 0)`} />
      <g
        set:html={cells}
        transform={`translate(${width * 1.5} ${height * 0.5})`}
      />
    </pattern>
    <rect width="100%" height="100%" fill={`url(#${patternId})`}></rect>
  </svg>
</div>

<style>
  .pixel-divider {
    display: flex;
    justify-content: center;
    opacity: 0.6;
    overflow: hidden;
  }
  svg {
    image-rendering: pixelated;
    max-width: 420px;
  }
</style>
