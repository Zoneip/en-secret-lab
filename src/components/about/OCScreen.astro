---
/**
 * 关于页 - 单个 OC 屏(独立子页面,动画与其它屏完全隔离)
 * 背景:静态帧立即显示 + 动画帧预载淡入
 */
import Mascot from '../mascot/Mascot.astro'
import { getTheme } from '../../lib/theme/presets'

interface Props {
  oc: {
    id: string
    theme: string
    name: string
    subtitle?: string
    description?: string
    traits: string[]
    quote?: string
    quoteEffect?: string
    quoteSpeed?: string
    art?: string
  }
  index: number
}

const { oc, index } = Astro.props
const OC_SCENE: Record<string, { light: string; dark: string }> = {
  gray: { light: 'gray-tech-light', dark: 'gray-tech-dark' },
  yellow: { light: 'yellow-field-light', dark: 'yellow-field-dark' },
  purple: { light: 'purple-library-day', dark: 'purple-library-night' },
  white: { light: 'white-sea-day', dark: 'white-sea-dark' },
}
const scene = OC_SCENE[oc.theme] ?? OC_SCENE.gray
const palette = getTheme(oc.theme).palette
const themeNames: Record<string, string> = { gray: '灰糖', yellow: '蜜糖', purple: '葡萄', white: '棉花糖' }
---

<section
  class="about-stage oc-screen"
  data-oc-theme={oc.theme}
  style={`--oc-index:${index}; --oc-bg-light:url(/wallpapers/${scene.light}-static.svg); --oc-bg-dark:url(/wallpapers/${scene.dark}-static.svg); --oc-bg-light-anim:url(/wallpapers/${scene.light}.svg); --oc-bg-dark-anim:url(/wallpapers/${scene.dark}.svg); --oc-overlay-light:${palette.light['wallpaper-overlay']}; --oc-overlay-dark:${palette.dark['wallpaper-overlay']}`}
>
  <div class="oc-bg" aria-hidden="true"></div>
  <div class="oc-inner">
    <div class="oc-art" data-motion-group="mascot" aria-hidden="true">
      {oc.art ? (
        <img src={oc.art} alt="" class="oc-art-img" />
      ) : (
        <>
          <Mascot role="furry" theme={oc.theme} pixel={9} />
          <Mascot role="boy" theme={oc.theme} pixel={7} />
        </>
      )}
    </div>
    <div class="oc-text">
      <p class="oc-theme-tag">主题 · {themeNames[oc.theme]}</p>
      <h2 class="oc-name">{oc.name}</h2>
      <p class="oc-subtitle">{oc.subtitle}</p>
      <p class="oc-desc">{oc.description}</p>
      <div class="oc-traits">
        {oc.traits.map((t) => (
          <span class="oc-trait">{t}</span>
        ))}
      </div>
      {oc.quote && (
        <p class="oc-quote" data-quote-effect={oc.quoteEffect} data-quote-speed={oc.quoteSpeed}>
          <span class="quote-text" data-quote-full={oc.quote}>「{oc.quote}」</span>
          <span class="quote-caret" aria-hidden="true"></span>
        </p>
      )}
    </div>
  </div>
  <footer class="screen-footer">
    <span>© {new Date().getFullYear()} EN · 秘密实验室</span>
    <a href="/rss.xml">RSS</a>
  </footer>
</section>

<style>
  /* 深浅色间接层:深色默认,浅色覆盖 */
  .about-stage {
    --p-bg: var(--pg-bg-dark, var(--pg-bg));
    --p-surface: var(--pg-surface-dark, var(--pg-surface));
    --p-elevated: var(--pg-elevated-dark, var(--pg-elevated));
    --p-fg: var(--pg-fg-dark, var(--pg-fg));
    --p-fg-muted: var(--pg-fg-muted-dark, var(--pg-fg-muted));
    --p-fg-subtle: var(--pg-fg-subtle-dark, var(--pg-fg-subtle));
    --p-primary: var(--pg-primary-dark, var(--pg-primary));
    --p-primary-soft: var(--pg-primary-soft-dark, var(--pg-primary-soft));
    --p-primary-fg: var(--pg-primary-fg-dark, var(--pg-primary-fg));
    --p-accent: var(--pg-accent-dark, var(--pg-accent));
    --p-accent-soft: var(--pg-accent-soft-dark, var(--pg-accent-soft));
    --p-border: var(--pg-border-dark, var(--pg-border));
    --p-border-strong: var(--pg-border-strong-dark, var(--pg-border-strong));
    --p-overlay: var(--pg-overlay-dark, var(--pg-overlay));
    --p-shadow: var(--pg-shadow-dark, var(--pg-shadow));
  }
  :root[data-mode='light'] .about-stage {
    --p-bg: var(--pg-bg);
    --p-surface: var(--pg-surface);
    --p-elevated: var(--pg-elevated);
    --p-fg: var(--pg-fg);
    --p-fg-muted: var(--pg-fg-muted);
    --p-fg-subtle: var(--pg-fg-subtle);
    --p-primary: var(--pg-primary);
    --p-primary-soft: var(--pg-primary-soft);
    --p-primary-fg: var(--pg-primary-fg);
    --p-accent: var(--pg-accent);
    --p-accent-soft: var(--pg-accent-soft);
    --p-border: var(--pg-border);
    --p-border-strong: var(--pg-border-strong);
    --p-overlay: var(--pg-overlay);
    --p-shadow: var(--pg-shadow);
  }
  .oc-screen {
    position: fixed;
    inset: 0;
    top: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow-y: auto;
    padding: 48px 56px 56px;
  }
  /* 背景:静态帧立即显示,动画帧由脚本预载后淡入(独立文档,无屏间干扰) */
  .oc-bg {
    position: absolute;
    inset: 0;
    background: var(--oc-bg-dark, var(--p-bg));
    z-index: -1;
  }
  :root[data-mode='light'] .oc-bg {
    background: var(--oc-bg-light, var(--p-bg));
  }
  .oc-bg-anim {
    position: absolute;
    inset: 0;
    background: var(--oc-bg-dark-anim);
    opacity: 0;
    display: none;
    z-index: -1;
  }
  :root[data-mode='light'] .oc-bg-anim {
    background: var(--oc-bg-light-anim);
  }
  .oc-screen[data-bg-ready] .oc-bg-anim {
    display: block;
    animation: bg-fade-in 0.5s var(--ease-soft) forwards;
  }
  @keyframes bg-fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  .oc-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--oc-overlay-dark, var(--wallpaper-overlay));
  }
  :root[data-mode='light'] .oc-bg::after {
    background: var(--oc-overlay-light, var(--wallpaper-overlay));
  }
  .oc-inner {
    position: relative;
    display: flex;
    align-items: center;
    gap: 56px;
    max-width: 860px;
    animation: screen-in 0.7s var(--ease-soft) 0.1s both;
  }
  @keyframes screen-in {
    from {
      opacity: 0;
      transform: translateY(32px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .oc-art {
    display: flex;
    gap: 4px;
    flex-shrink: 0;
    padding: 18px;
    border-radius: 28px;
    background: var(--p-surface);
    border: 1px solid var(--p-border);
    box-shadow: var(--p-shadow);
    animation: bob 4s ease-in-out infinite;
  }
  .oc-art-img {
    width: 220px;
    height: 220px;
    object-fit: cover;
    border-radius: 20px;
  }
  @keyframes bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }
  .oc-text {
    min-width: 0;
  }
  .oc-theme-tag {
    display: inline-block;
    font-size: 0.78rem;
    padding: 2px 12px;
    border-radius: 999px;
    background: var(--p-primary-soft);
    color: var(--p-primary);
    margin-bottom: 12px;
  }
  .oc-name {
    font-size: 3rem;
    color: var(--p-primary);
    line-height: 1.1;
  }
  .oc-subtitle {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--p-fg);
    margin: 6px 0 14px;
  }
  .oc-desc {
    color: var(--p-fg-muted);
    max-width: 46ch;
    line-height: 1.9;
  }
  .oc-traits {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 18px;
  }
  .oc-trait {
    font-size: 0.82rem;
    padding: 3px 14px;
    border-radius: 999px;
    border: 1.5px solid var(--p-border-strong);
    color: var(--p-fg-muted);
  }
  .oc-quote {
    margin-top: 18px;
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--p-primary);
  }
  /* ===== 名言动效 ===== */
  .quote-caret {
    display: none;
    width: 2px;
    height: 1.15em;
    margin-left: 3px;
    background: currentColor;
    vertical-align: text-bottom;
  }
  [data-quote-effect='typing'] .quote-caret {
    display: inline-block;
    animation: caret-blink 0.9s steps(1) infinite;
  }
  @keyframes caret-blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }
  [data-quote-effect='fade'] .quote-text {
    display: inline-block;
    animation: quote-fade 3.2s ease-in-out infinite;
  }
  [data-quote-effect='fade'][data-quote-speed='slow'] .quote-text {
    animation-duration: 4.6s;
  }
  [data-quote-effect='fade'][data-quote-speed='fast'] .quote-text {
    animation-duration: 2.2s;
  }
  @keyframes quote-fade {
    0%,
    100% {
      opacity: 0.35;
    }
    50% {
      opacity: 1;
    }
  }
  [data-quote-effect='float'] .quote-text {
    display: inline-block;
    animation: quote-float 3.2s ease-in-out infinite;
  }
  [data-quote-effect='float'][data-quote-speed='slow'] .quote-text {
    animation-duration: 4.6s;
  }
  [data-quote-effect='float'][data-quote-speed='fast'] .quote-text {
    animation-duration: 2.2s;
  }
  @keyframes quote-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-5px);
    }
  }
  .screen-footer {
    position: absolute;
    bottom: 14px;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    font-size: 0.72rem;
    color: var(--p-fg-subtle);
    z-index: 5;
    pointer-events: none;
  }
  .screen-footer a {
    pointer-events: auto;
    color: var(--p-fg-subtle);
    text-decoration: none;
  }
  .screen-footer a:hover {
    color: var(--p-primary);
  }
  @media (max-width: 760px) {
    .oc-inner {
      flex-direction: column;
      gap: 28px;
      text-align: center;
    }
    .oc-art {
      transform: scale(0.85);
    }
    .oc-text {
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .oc-name {
      font-size: 2.4rem;
    }
    .oc-desc {
      max-width: 36ch;
    }
    .oc-traits {
      justify-content: center;
    }
  }
</style>

<script is:inline data-astro-rerun>
  ;(function () {
    // 背景动画帧预载(独立页面:加载即预载当前屏,无其它屏干扰)
    const ocScreen = document.querySelector('.oc-screen')
    if (ocScreen) {
      const light = ocScreen.style.getPropertyValue('--oc-bg-light-anim').trim()
      const dark = ocScreen.style.getPropertyValue('--oc-bg-dark-anim').trim()
      const pick = document.documentElement.dataset.mode === 'dark' ? dark : light
      const img = new Image()
      img.onload = () => ocScreen.setAttribute('data-bg-ready', '')
      img.src = pick.replace(/^url\(["']?(.*?)["']?\)$/, '$1')
    }
    // 打字机直接播放(页面唯一,无需观察器)
    const TYPE_SPEED = { slow: 95, normal: 55, fast: 28 }
    const q = document.querySelector('[data-quote-effect="typing"]')
    if (q) {
      const text = q.querySelector('.quote-text')
      const full = text?.dataset.quoteFull ?? ''
      const speed = TYPE_SPEED[q.dataset.quoteSpeed] ?? 55
      text.textContent = ''
      let i = 0
      const timer = window.setInterval(() => {
        i++
        text.textContent = `「${full.slice(0, i)}」`
        if (i >= full.length) window.clearInterval(timer)
      }, speed)
    }
  })()
</script>
