---
/** 关于页 v5 - OC 屏内容组件(配色/壁纸跟随全局主题,无独立背景) */
import Mascot from '../mascot/Mascot.astro'
import { withBase } from '../../lib/utils'

interface Props {
  oc: {
    id: string
    theme: string
    name: string
    subtitle?: string
    description?: string
    traits: string[]
    quote?: string
    quoteEffect?: string
    quoteSpeed?: string
    art?: string
  }
  /** 奇偶交错:true = 图右文左 */
  flip: boolean
}

const { oc, flip } = Astro.props
const themeNames: Record<string, string> = {
  gray: '灰糖',
  yellow: '蜜糖',
  purple: '葡萄',
  white: '棉花糖',
}
---

<section
  class:list={['snap-section', 'oc-screen', { flip }]}
  data-screen
  data-oc-theme={oc.theme}
  aria-labelledby={`oc-name-${oc.theme}`}
>
  <div class="oc-inner">
    <div class="oc-art" data-motion-group="mascot" aria-hidden="true">
      {
        oc.art ? (
          <img src={oc.art} alt="" class="oc-art-img" loading="lazy" />
        ) : (
          <>
            <Mascot role="furry" theme={oc.theme} pixel={9} />
            <Mascot role="boy" theme={oc.theme} pixel={7} />
          </>
        )
      }
    </div>
    <div class="oc-text">
      <p class="oc-theme-tag">主题 · {themeNames[oc.theme]}</p>
      <h2 class="oc-name" id={`oc-name-${oc.theme}`}>{oc.name}</h2>
      {oc.subtitle && <p class="oc-subtitle">{oc.subtitle}</p>}
      {oc.description && <p class="oc-desc">{oc.description}</p>}
      {
        oc.traits.length > 0 && (
          <ul class="oc-traits">
            {oc.traits.map((t) => (
              <li class="oc-trait">{t}</li>
            ))}
          </ul>
        )
      }
      {
        oc.quote && (
          <p
            class="oc-quote"
            data-quote-effect={oc.quoteEffect}
            data-quote-speed={oc.quoteSpeed}
          >
            <span class="quote-text" data-quote-full={oc.quote}>
              「{oc.quote}」
            </span>
            <span class="quote-caret" aria-hidden="true" />
          </p>
        )
      }
    </div>
  </div>
  <footer class="screen-footer">
    <span>© {new Date().getFullYear()} EN · 秘密实验室</span>
    <a href={withBase('/rss.xml')}>RSS</a>
  </footer>
</section>

<style>
  .oc-inner {
    display: flex;
    align-items: center;
    gap: clamp(28px, 6vw, 64px);
    max-width: 860px;
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.6s var(--ease-soft) 0.1s,
      transform 0.6s var(--ease-soft) 0.1s;
  }
  .snap-section.active .oc-inner {
    opacity: 1;
    transform: none;
  }
  .flip .oc-inner {
    flex-direction: row-reverse;
  }
  .oc-art {
    display: flex;
    gap: 4px;
    flex-shrink: 0;
    padding: 18px;
    border-radius: 24px;
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
  }
  .snap-section.active .oc-art {
    animation: bob 4s ease-in-out infinite;
  }
  .snap-section:not(.active) .oc-art,
  .snap-section:not(.active) [data-motion-group] {
    animation: none;
  }
  .snap-section:not(.active) .oc-inner {
    transition: none;
  }
  @keyframes bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }
  .oc-art-img {
    width: 220px;
    height: 220px;
    object-fit: cover;
    border-radius: 20px;
  }
  .oc-text {
    min-width: 0;
  }
  .oc-theme-tag {
    display: inline-block;
    font-size: 0.78rem;
    padding: 2px 12px;
    border-radius: 999px;
    background: var(--primary-soft);
    color: var(--primary);
    margin-bottom: 12px;
  }
  .oc-name {
    font-size: clamp(2rem, 4vw, 2.8rem);
    color: var(--primary);
    line-height: 1.1;
  }
  .oc-subtitle {
    font-family: var(--font-display);
    font-size: 1.2rem;
    color: var(--fg);
    margin: 6px 0 14px;
  }
  .oc-desc {
    color: var(--fg-muted);
    max-width: 46ch;
    line-height: 1.9;
  }
  .oc-traits {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 18px;
    padding: 0;
  }
  .oc-trait {
    font-size: 0.82rem;
    padding: 3px 14px;
    border-radius: 999px;
    border: 1.5px solid var(--border-strong);
    color: var(--fg-muted);
  }
  .oc-quote {
    margin-top: 18px;
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--primary);
  }
  .quote-caret {
    display: none;
    width: 2px;
    height: 1.15em;
    margin-left: 3px;
    background: currentColor;
    vertical-align: text-bottom;
  }
  [data-quote-effect='typing'] .quote-caret {
    display: inline-block;
    animation: caret-blink 0.9s steps(1) infinite;
  }
  @keyframes caret-blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }
  [data-quote-effect='fade'] .quote-text {
    display: inline-block;
    animation: quote-fade 3.2s ease-in-out infinite;
  }
  [data-quote-effect='fade'][data-quote-speed='slow'] .quote-text {
    animation-duration: 4.6s;
  }
  [data-quote-effect='fade'][data-quote-speed='fast'] .quote-text {
    animation-duration: 2.2s;
  }
  @keyframes quote-fade {
    0%,
    100% {
      opacity: 0.35;
    }
    50% {
      opacity: 1;
    }
  }
  [data-quote-effect='float'] .quote-text {
    display: inline-block;
    animation: quote-float 3.2s ease-in-out infinite;
  }
  [data-quote-effect='float'][data-quote-speed='slow'] .quote-text {
    animation-duration: 4.6s;
  }
  [data-quote-effect='float'][data-quote-speed='fast'] .quote-text {
    animation-duration: 2.2s;
  }
  @keyframes quote-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-5px);
    }
  }
  .screen-footer {
    position: absolute;
    bottom: 14px;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    font-size: 0.72rem;
    color: var(--fg-subtle);
    z-index: 5;
    pointer-events: none;
  }
  .screen-footer a {
    pointer-events: auto;
    color: var(--fg-subtle);
    text-decoration: none;
  }
  .screen-footer a:hover {
    color: var(--primary);
  }
  @media (max-width: 760px) {
    .oc-inner,
    .flip .oc-inner {
      flex-direction: column;
      gap: 28px;
      text-align: center;
    }
    .oc-art {
      transform: scale(0.85);
    }
    .oc-text {
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .oc-name {
      font-size: 2.4rem;
    }
    .oc-desc {
      max-width: 36ch;
    }
    .oc-traits {
      justify-content: center;
    }
  }
</style>
