---
/** 关于页 v4 - 圆点导航 + 进度条(点击跳屏,无滚轮劫持) */
interface Props {
  count: number
}

const { count } = Astro.props
const n = Math.max(1, count)
---

<nav class="about-dots" aria-label="页面导航">
  {Array.from({ length: n }, (_, i) => (
    <button class="about-dot" data-dot={i} aria-label={`第 ${i + 1} 屏`}></button>
  ))}
</nav>
<div class="about-track" aria-hidden="true">
  <div class="about-track-fill" data-track-fill></div>
</div>

<style>
  .about-dots {
    position: fixed;
    bottom: 44px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 12px;
    z-index: 20;
  }
  .about-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: none;
    background: var(--border-strong);
    cursor: pointer;
    transition: all 0.3s var(--ease-spring);
    opacity: 0.6;
  }
  .about-dot:hover {
    opacity: 1;
  }
  .about-dot.active {
    background: var(--primary);
    opacity: 1;
    transform: scale(1.4);
  }
  .about-track {
    position: fixed;
    bottom: 14px;
    left: 50%;
    transform: translateX(-50%);
    width: 44px;
    height: 3px;
    border-radius: 999px;
    background: var(--border);
    overflow: hidden;
    z-index: 20;
    opacity: 0.6;
  }
  .about-track-fill {
    height: 100%;
    width: 20%;
    border-radius: 999px;
    background: var(--primary);
    transition: transform 0.35s var(--ease-soft);
  }
  @media (max-width: 760px) {
    .about-dots {
      bottom: 18px;
    }
    .about-track {
      display: none;
    }
  }
</style>

<script is:inline>
  ;(function () {
    const scroller = document.querySelector('[data-snap-scroller]')
    const dots = [...document.querySelectorAll('[data-dot]')]
    const trackFill = document.querySelector('[data-track-fill]')
    if (!scroller || !dots.length) return

    const update = () => {
      const idx = Math.round(scroller.scrollLeft / scroller.clientWidth)
      dots.forEach((d, i) => d.classList.toggle('active', i === idx))
      const max = scroller.scrollWidth - scroller.clientWidth
      const ratio = max > 0 ? scroller.scrollLeft / max : 0
      if (trackFill) trackFill.style.transform = `translateX(${ratio * 400}%)`
    }
    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        scroller.scrollTo({ left: i * scroller.clientWidth, behavior: 'smooth' })
      })
    })
    scroller.addEventListener('scroll', update, { passive: true })
    update()
  })()
</script>
