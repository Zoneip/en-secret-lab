---
/** 站点头部:Logo + 导航 + 搜索入口 */
import { getSiteConfig } from '../../lib/config'

interface Props {
  active?: string
}

const { active } = Astro.props
const config = getSiteConfig()
const current = active ?? Astro.url.pathname
---

<header class="site-header" data-motion-group="topbar">
  <div class="container header-inner">
    <a href="/" class="brand underline-tail" aria-label="回到首页">
      <span class="brand-mark" aria-hidden="true"></span>
      <span class="brand-name">{config.title}</span>
    </a>

    <nav class="nav" aria-label="主导航">
      <ul>
        {config.nav.map((item) => (
          <li>
            <a
              href={item.url}
              class:list={['nav-link underline-tail', { active: current === item.url }]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="actions">
      <a href="/search" class="btn btn-ghost btn-icon" aria-label="搜索">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <path d="m21 21-4.35-4.35" stroke-linecap="round" />
        </svg>
        <span class="search-label">搜索</span>
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    background-color: var(--topbar-bg, color-mix(in srgb, var(--bg) 76%, transparent));
    background-image:
      var(--topbar-tint, linear-gradient(180deg, color-mix(in srgb, var(--primary) 16%, transparent), color-mix(in srgb, var(--accent) 7%, transparent) 100%)),
      var(--topbar-grad, none);
    backdrop-filter: blur(var(--topbar-blur, 12px));
    border-bottom: 1px solid var(--border);
    /* 装饰层(主题绑定):accent 渐变线 + ornament 像素装饰 */
  }
  .site-header::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: var(--topbar-line, none);
    opacity: 0.85;
    pointer-events: none;
  }
  .site-header::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: var(--topbar-ornament-src, none);
    background-repeat: repeat-x;
    background-position: bottom 5px left;
    opacity: 0.55;
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 16px;
    height: var(--topbar-height, var(--header-h));
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--fg);
    white-space: nowrap;
  }
  .brand-mark {
    width: 30px;
    height: 30px;
    border-radius: 10px;
    background: linear-gradient(135deg, var(--primary), var(--accent));
    box-shadow: 0 2px 8px color-mix(in srgb, var(--primary) 40%, transparent);
    flex-shrink: 0;
  }
  .nav {
    flex: 1;
    min-width: 0;
  }
  .nav ul {
    display: flex;
    gap: 4px;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .nav ul::-webkit-scrollbar {
    display: none;
  }
  .nav-link {
    display: inline-block;
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    font-size: 0.95rem;
    color: var(--fg-muted);
    white-space: nowrap;
  }
  .nav-link:hover {
    color: var(--primary);
  }
  .nav-link.active {
    background: var(--primary-soft);
    color: var(--primary);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .btn-icon {
    padding: 8px 16px;
  }
  .search-label {
    font-size: 0.9rem;
  }

  @media (max-width: 640px) {
    .search-label {
      display: none;
    }
    .btn-icon {
      padding: 9px;
    }
    .brand-name {
      max-width: 40vw;
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }
</style>
