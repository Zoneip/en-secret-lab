---
/** 固定背景壁纸层:
 *  静态帧(visibility 显隐,8 层全部随页面加载进缓存)→ 首帧即时显示
 *  动画帧(display 显隐 + JS 预加载)→ 加载完成后淡入覆盖,滚动/切主题无加载缺口
 */
import { getTheme } from '../../lib/theme/presets'

interface Props {
  theme: string
  enabled?: boolean
}

const { theme: fallbackTheme, enabled = true } = Astro.props
const themeIds = ['gray', 'yellow', 'purple', 'white'] as const
const SCENE: Record<string, { light: string; dark: string }> = {
  gray: { light: 'gray-tech-light', dark: 'gray-tech-dark' },
  yellow: { light: 'yellow-field-light', dark: 'yellow-field-dark' },
  purple: { light: 'purple-library-day', dark: 'purple-library-night' },
  white: { light: 'white-sea-day', dark: 'white-sea-dark' },
}
const presets = themeIds.map((id) => ({ id, preset: getTheme(id) }))
const sceneFile = (id: string, m: 'light' | 'dark', anim: boolean) =>
  `${SCENE[id][m]}${anim ? '' : '-static'}.svg`
---

<div class:list={['wallpaper', { 'wallpaper-hidden': !enabled }]} aria-hidden="true" data-wallpaper-fallback={fallbackTheme}>
  {presets.map(({ id }) => (
    <Fragment>
      <div class="wallpaper-base" data-wallpaper-theme={id} data-wallpaper-light>
        <div class="wl-static" style={`background-image:url(/wallpapers/${sceneFile(id, 'light', false)})`}></div>
      </div>
      <div class="wallpaper-base" data-wallpaper-theme={id} data-wallpaper-dark>
        <div class="wl-static" style={`background-image:url(/wallpapers/${sceneFile(id, 'dark', false)})`}></div>
      </div>
    </Fragment>
  ))}
  <div class="wallpaper-overlay"></div>
</div>

<style is:global>
  .wallpaper {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    transition: opacity 0.4s var(--ease-soft);
  }
  .wallpaper-hidden {
    opacity: 0;
  }
  /* 全屏页自带主题背景:整体卸载壁纸层(不再播放,释放合成器) */
  body[data-no-wallpaper='true'] .wallpaper {
    display: none;
  }
  /* 只有当前主题+模式的层参与渲染;静态帧立即显示,动画帧由 JS 预载后淡入 */
  .wallpaper-base {
    position: absolute;
    inset: 0;
    visibility: hidden;
  }
  .wallpaper-base .wl-static {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
  }
  .wallpaper-base .wl-anim {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    opacity: 0;
    display: none;
  }
  .wallpaper-base[data-wl-ready] .wl-anim {
    display: block;
    animation: wallpaper-fade-in 0.5s var(--ease-soft) forwards;
  }
  /* 默认兜底:JS 未运行或未设主题时,显示 SSR 兜底主题的浅色静态帧 */
  html:not([data-theme]):not([data-mode]) .wallpaper-base[data-wallpaper-theme='gray'][data-wallpaper-light],
  html:not([data-theme])[data-mode='light'] .wallpaper-base[data-wallpaper-theme='gray'][data-wallpaper-light],
  html:not([data-theme])[data-mode='dark'] .wallpaper-base[data-wallpaper-theme='gray'][data-wallpaper-dark] {
    visibility: visible;
  }
  /* 按客户端实际主题 + 模式显隐 */
  html[data-theme='gray'][data-mode='light'] .wallpaper-base[data-wallpaper-theme='gray'][data-wallpaper-light],
  html[data-theme='gray'][data-mode='dark'] .wallpaper-base[data-wallpaper-theme='gray'][data-wallpaper-dark],
  html[data-theme='yellow'][data-mode='light'] .wallpaper-base[data-wallpaper-theme='yellow'][data-wallpaper-light],
  html[data-theme='yellow'][data-mode='dark'] .wallpaper-base[data-wallpaper-theme='yellow'][data-wallpaper-dark],
  html[data-theme='purple'][data-mode='light'] .wallpaper-base[data-wallpaper-theme='purple'][data-wallpaper-light],
  html[data-theme='purple'][data-mode='dark'] .wallpaper-base[data-wallpaper-theme='purple'][data-wallpaper-dark],
  html[data-theme='white'][data-mode='light'] .wallpaper-base[data-wallpaper-theme='white'][data-wallpaper-light],
  html[data-theme='white'][data-mode='dark'] .wallpaper-base[data-wallpaper-theme='white'][data-wallpaper-dark] {
    visibility: visible;
  }
  @keyframes wallpaper-fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  .wallpaper-overlay {
    position: absolute;
    inset: 0;
    background: var(--wallpaper-overlay);
    backdrop-filter: blur(0px);
    transition: background 0.4s var(--ease-soft);
  }
</style>


