---
/** 固定背景壁纸层(精灵分层版):
 *  静态底图(bg.svg,background-image,一次栅格化零成本)
 *  + 动画层(anim.svg,SSR 内联 inline SVG,元素级合成,transform 走 GPU)
 *  仅当前主题+模式渲染(其余 display:none,零动画开销)
 */
import { readFileSync } from 'node:fs'
import { join } from 'node:path'
import { getTheme } from '../../lib/theme/presets'
import { withBase } from '../../lib/utils'

interface Props {
  theme: string
  enabled?: boolean
}

const { theme: fallbackTheme, enabled = true } = Astro.props
// 构建/运行时工作目录恒为项目根(dev=src,server=dist-server/server,static=dist-static 层级不同,
// 用 import.meta.url 上溯会因构建产物目录结构差异指向错误位置导致动画层读空)
const root = process.cwd()
const themeIds = ['gray', 'yellow', 'purple', 'white', 'friends'] as const
const SCENE: Record<string, { light: string; dark: string }> = {
  gray: { light: 'gray-tech-light', dark: 'gray-tech-dark' },
  yellow: { light: 'yellow-field-light', dark: 'yellow-field-dark' },
  purple: { light: 'purple-library-day', dark: 'purple-library-night' },
  white: { light: 'white-sea-day', dark: 'white-sea-dark' },
  friends: { light: 'friends-shrine-day', dark: 'friends-shrine-night' },
}
const presets = themeIds.map((id) => ({ id, preset: getTheme(id) }))
const animSvg = (name: string) => {
  try {
    return readFileSync(
      join(root, 'public', 'wallpapers', `${name}-anim.svg`),
      'utf8',
    )
  } catch {
    return ''
  }
}
---

<div
  class:list={['wallpaper', { 'wallpaper-hidden': !enabled }]}
  aria-hidden="true"
  data-wallpaper-fallback={fallbackTheme}
>
  {
    presets.map(({ id }) => (
      <Fragment>
        <div
          class="wallpaper-base"
          data-wallpaper-theme={id}
          data-wallpaper-light
        >
          <div
            class="wl-static"
            style={`background-image:url(${withBase(`/wallpapers/${SCENE[id].light}-bg.svg`)})`}
          />
          <div class="wl-anim-layer" set:html={animSvg(SCENE[id].light)} />
        </div>
        <div
          class="wallpaper-base"
          data-wallpaper-theme={id}
          data-wallpaper-dark
        >
          <div
            class="wl-static"
            style={`background-image:url(${withBase(`/wallpapers/${SCENE[id].dark}-bg.svg`)})`}
          />
          <div class="wl-anim-layer" set:html={animSvg(SCENE[id].dark)} />
        </div>
      </Fragment>
    ))
  }
  <div class="wallpaper-overlay"></div>
</div>

<style is:global>
  .wallpaper {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    transition: opacity 0.4s var(--ease-soft);
  }
  .wallpaper-hidden {
    opacity: 0;
  }
  /* 仅当前主题+模式渲染;其余 display:none(动画层一并移除,零合成开销) */
  .wallpaper-base {
    position: absolute;
    inset: 0;
    display: none;
  }
  html[data-theme='gray'][data-mode='light']
    .wallpaper-base[data-wallpaper-theme='gray'][data-wallpaper-light],
  html[data-theme='gray'][data-mode='dark']
    .wallpaper-base[data-wallpaper-theme='gray'][data-wallpaper-dark],
  html[data-theme='yellow'][data-mode='light']
    .wallpaper-base[data-wallpaper-theme='yellow'][data-wallpaper-light],
  html[data-theme='yellow'][data-mode='dark']
    .wallpaper-base[data-wallpaper-theme='yellow'][data-wallpaper-dark],
  html[data-theme='purple'][data-mode='light']
    .wallpaper-base[data-wallpaper-theme='purple'][data-wallpaper-light],
  html[data-theme='purple'][data-mode='dark']
    .wallpaper-base[data-wallpaper-theme='purple'][data-wallpaper-dark],
  html[data-theme='white'][data-mode='light']
    .wallpaper-base[data-wallpaper-theme='white'][data-wallpaper-light],
  html[data-theme='white'][data-mode='dark']
    .wallpaper-base[data-wallpaper-theme='white'][data-wallpaper-dark],
  html[data-theme='friends'][data-mode='light']
    .wallpaper-base[data-wallpaper-theme='friends'][data-wallpaper-light],
  html[data-theme='friends'][data-mode='dark']
    .wallpaper-base[data-wallpaper-theme='friends'][data-wallpaper-dark] {
    display: block;
  }
  /* 主题切换时启用淡入动画(首次加载不播放,避免首屏壁纸淡入造成顶部栏背景闪烁) */
  html.anim-theme .wallpaper-base {
    animation: wl-fade-in 0.45s var(--ease-soft) both;
  }
  /* 兜底:JS 未运行 */
  html:not([data-theme]):not([data-mode])
    .wallpaper-base[data-wallpaper-theme='gray'][data-wallpaper-light],
  html:not([data-theme])[data-mode='light']
    .wallpaper-base[data-wallpaper-theme='gray'][data-wallpaper-light],
  html:not([data-theme])[data-mode='dark']
    .wallpaper-base[data-wallpaper-theme='gray'][data-wallpaper-dark] {
    display: block;
  }
  @keyframes wl-fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  .wl-static {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
  }
  /* 手机竖屏优先显示壁纸上半部,避免主体被过度裁切 */
  @media (max-width: 768px) {
    .wl-static {
      background-position: top center;
    }
  }
  .wl-anim-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .wl-anim-layer svg {
    width: 100%;
    height: 100%;
  }
  .wallpaper-overlay {
    position: absolute;
    inset: 0;
    background: var(--wallpaper-overlay);
    backdrop-filter: blur(0px);
    transition: background 0.4s var(--ease-soft);
  }
</style>
