---
/** 友链页专属壁纸(精灵分层):静态底图 + inline SVG 动画层 */
import { readFileSync } from 'node:fs'
import { join, dirname } from 'node:path'
import { fileURLToPath } from 'node:url'
import { withBase } from '../../lib/utils'

interface Props {
  enabled?: boolean
}

const { enabled = true } = Astro.props
const root = join(dirname(fileURLToPath(import.meta.url)), '..', '..', '..')
const animSvg = (name: string) => {
  try {
    return readFileSync(
      join(root, 'public', 'wallpapers', `${name}-anim.svg`),
      'utf8',
    )
  } catch {
    return ''
  }
}
---

<div
  class:list={['friends-wallpaper', { 'friends-wallpaper-hidden': !enabled }]}
  aria-hidden="true"
>
  <div
    class="fw-base"
    data-fw-light
    data-fw-static
    style={`background-image:url(${withBase('/wallpapers/friends-shrine-day-bg.svg')})`}
  >
  </div>
  <div
    class="fw-base"
    data-fw-dark
    data-fw-static
    style={`background-image:url(${withBase('/wallpapers/friends-shrine-night-bg.svg')})`}
  >
  </div>
  <div class="fw-anim" data-fw-light set:html={animSvg('friends-shrine-day')} />
  <div
    class="fw-anim"
    data-fw-dark
    set:html={animSvg('friends-shrine-night')}
  />
  <div class="fw-overlay"></div>
</div>

<style is:global>
  .friends-wallpaper {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    transition: opacity 0.4s var(--ease-soft);
  }
  .friends-wallpaper-hidden {
    opacity: 0;
  }
  .fw-base {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    visibility: hidden;
  }
  .fw-anim {
    position: absolute;
    inset: 0;
    visibility: hidden;
    pointer-events: none;
  }
  .fw-anim svg {
    width: 100%;
    height: 100%;
  }
  html[data-mode='light'] .fw-base[data-fw-light],
  html[data-mode='light'] .fw-anim[data-fw-light] {
    visibility: visible;
    animation: fw-fade-in 0.45s var(--ease-soft) both;
  }
  html[data-mode='dark'] .fw-base[data-fw-dark],
  html[data-mode='dark'] .fw-anim[data-fw-dark] {
    visibility: visible;
    animation: fw-fade-in 0.45s var(--ease-soft) both;
  }
  @keyframes fw-fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  .fw-overlay {
    position: absolute;
    inset: 0;
    background: var(--wallpaper-overlay);
  }
</style>
