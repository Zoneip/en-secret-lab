---
/**
 * 全局布局:主题引导(防 FOUC)、SEO、头部/底部/壁纸/主题切换器
 */
import '@fontsource/zcool-kuaile/400.css'
import '@fontsource/zcool-qingke-huangyou/400.css'
import '@fontsource/noto-sans-sc/400.css'
import '@fontsource/noto-sans-sc/500.css'
import '@fontsource/noto-sans-sc/700.css'
import '@fontsource/jetbrains-mono/400.css'

import '../styles/global.css'
import '../styles/prose.css'
import '../styles/theme-tokens.generated.css'
import '../assets/motion/keyframes/mascot.css'
import '../assets/motion/keyframes/cards.css'
import '../assets/motion/keyframes/topbar.css'
import '../assets/motion/keyframes/ambient.css'

import { getSiteConfig, getThemeOverrides } from '../lib/config'
import { isServer } from '../lib/utils'
import { buildMeta } from '../lib/seo'
import { absoluteUrl } from '../lib/utils'
import { bootScript } from '../lib/theme/prefs'
import { themeOverrideCss } from '../lib/theme/css'
import SkipLink from '../components/layout/SkipLink.astro'
import SiteHeader from '../components/layout/SiteHeader.astro'
import SiteFooter from '../components/layout/SiteFooter.astro'
import WallpaperLayer from '../components/layout/WallpaperLayer.astro'
import ThemeSwitcher from '../components/theme/ThemeSwitcher.astro'

interface Props {
  title: string
  description?: string
  image?: string
  type?: 'website' | 'article'
  /** 强制主题(栏目页使用,锁定该主题配色) */
  forceTheme?: string
  /** 隐藏全局页脚(全屏滑动页使用,页脚内嵌各屏) */
  hideFooter?: boolean
  /** 内容撑满视口,页脚贴底(内容稀疏的列表页使用) */
  fillViewport?: boolean
}

const config = getSiteConfig()
const overrideCss = themeOverrideCss(getThemeOverrides())
const { title, description, image, type, forceTheme, hideFooter = false, fillViewport = false } = Astro.props
const resolvedTheme = forceTheme ?? config.defaultTheme
const lightDefault = config.themeByMode.light
const darkDefault = config.themeByMode.dark
// 全局动效预设(控制台可调控)
const motion = config.homepage.motion
const motionSpeed = { slow: '4.5s', normal: '3s', fast: '1.8s' }[motion.speed]
const siteUrl = Astro.site?.toString() ?? 'http://localhost:4321'
const pageUrl = absoluteUrl(siteUrl, Astro.url.pathname)
const meta = buildMeta({
  title,
  description: description ?? config.description,
  type,
  url: pageUrl,
  image,
  siteTitle: config.title,
  siteUrl,
})
---

<!doctype html>
<html lang="zh-CN" data-theme={resolvedTheme} {...(forceTheme ? { 'data-force-theme': forceTheme } : {})}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{meta.find((m) => 'title' in m)?.title ?? title}</title>
    {meta
      .filter((m) => !('title' in m))
      .map((m) => <meta {...m} />)}
    {overrideCss && <style set:html={overrideCss}></style>}
    <script set:html={bootScript(lightDefault, darkDefault)} />
    <script>
      // 主题切换时附加过渡动画类(由 ThemeSwitcher 触发)
      window.addEventListener('enlab:theme-change', () => {
        document.documentElement.classList.add('anim-theme')
        window.setTimeout(
          () => document.documentElement.classList.remove('anim-theme'),
          400,
        )
      })
    </script>
  </head>
  <body
    data-is-server-runtime={String(isServer)}
    data-default-theme-light={lightDefault}
    data-default-theme-dark={darkDefault}
    {...(fillViewport ? { 'data-fill-viewport': 'true' } : {})}
    data-motion-hero={motion.hero} data-motion-mascot={motion.mascot} data-motion-cards={motion.cards} data-motion-topbar={motion.topbar} data-motion-ambient={motion.ambient} style={`--motion-duration:${motionSpeed}`}>
    <SkipLink />
    <WallpaperLayer theme={config.defaultTheme} enabled={config.features.wallpapers} />
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    {!hideFooter && <SiteFooter />}
    <ThemeSwitcher />

    <script>
      // 动效预设应用(控制台"站点设置→主页"调控)
      const MOTION_CLASSES: Record<string, Record<string, string>> = {
        mascot: { bob: 'motion-bob', 'ear-tip': 'motion-ear-tip', 'tail-wag': 'motion-tail-wag', wobble: 'motion-wobble' },
        cards: {
          'card-lift': 'motion-card-lift',
          'card-tilt': 'motion-card-tilt',
          'card-sheen': 'motion-card-sheen',
          'card-border-flow': 'motion-card-border-flow',
          'card-float-in': 'motion-card-float-in',
        },
        topbar: { 'topbar-gradient': 'motion-topbar-gradient', 'nav-underline': 'motion-nav-underline' },
        ambient: {
          'pulse-soft': 'motion-pulse-soft',
          'scroll-hint': 'motion-scroll-hint',
          'float-slow': 'motion-float-slow',
          'spin-slow': 'motion-spin-slow',
        },
        hero: { 'float-slow': 'motion-float-slow', 'spin-slow': 'motion-spin-slow' },
      }
      const groups = ['mascot', 'cards', 'topbar', 'ambient', 'hero']
      for (const group of groups) {
        const key = 'motion' + group.charAt(0).toUpperCase() + group.slice(1)
        const effect = document.body.dataset[key]
        const cls = MOTION_CLASSES[group]?.[effect ?? 'none']
        if (!cls) continue
        document.querySelectorAll(`[data-motion-group="${group}"]`).forEach((el) => el.classList.add(cls))
      }
    </script>
    <style>
      body[data-fill-viewport='true'] {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }
      body[data-fill-viewport='true'] main {
        flex: 1;
      }
    </style>
  </body>
</html>
