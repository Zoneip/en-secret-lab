---
/**
 * 控制台布局:独立于前台主题系统的简洁面板风
 * 左侧导航 + 内容区;仅动态版使用
 */
interface Props {
  title: string
  active: string
}

const { title, active } = Astro.props

const nav = [
  { key: 'dashboard', label: '仪表盘', href: '/admin' },
  { key: 'themes', label: '主题', href: '/admin/themes' },
  { key: 'site', label: '站点设置', href: '/admin/site' },
  { key: 'assets', label: '资产', href: '/admin/assets' },
]
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · 控制台</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style is:global>
      :root {
        --a-bg: #f4f5f7;
        --a-surface: #ffffff;
        --a-border: #e3e5ea;
        --a-fg: #2b2e35;
        --a-fg-muted: #5c6170;
        --a-fg-subtle: #8a8f9e;
        --a-primary: #5c677d;
        --a-primary-soft: #eaedf2;
      }
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      body {
        font-family: 'Noto Sans SC', system-ui, sans-serif;
        background: var(--a-bg);
        color: var(--a-fg);
        min-height: 100vh;
        font-size: 14px;
        line-height: 1.6;
      }
      .btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 18px;
        border-radius: 999px;
        border: 1px solid var(--a-border);
        background: var(--a-surface);
        color: var(--a-fg);
        font-size: 13px;
        cursor: pointer;
        transition: all 0.2s;
      }
      .btn:hover {
        border-color: var(--a-primary);
        color: var(--a-primary);
      }
      .btn-primary {
        background: var(--a-primary);
        border-color: var(--a-primary);
        color: #fff;
      }
      .btn-primary:hover {
        color: #fff;
        opacity: 0.9;
      }
      .btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
      }
      .card {
        background: var(--a-surface);
        border: 1px solid var(--a-border);
        border-radius: 14px;
        padding: 20px;
      }
      .field {
        margin-bottom: 14px;
      }
      .field label {
        display: block;
        font-size: 12px;
        color: var(--a-fg-muted);
        margin-bottom: 5px;
      }
      .field input[type='text'],
      .field input[type='password'],
      .field input[type='url'],
      .field input[type='number'],
      .field select,
      .field textarea {
        width: 100%;
        padding: 8px 12px;
        border: 1px solid var(--a-border);
        border-radius: 10px;
        font-size: 13px;
        font-family: inherit;
        background: var(--a-surface);
        color: var(--a-fg);
      }
      .field input:focus,
      .field select:focus,
      .field textarea:focus {
        outline: 2px solid var(--a-primary);
        outline-offset: -1px;
      }
      .toast {
        position: fixed;
        top: 16px;
        right: 16px;
        z-index: 50;
        padding: 10px 18px;
        border-radius: 12px;
        background: #2f3542;
        color: #fff;
        font-size: 13px;
        opacity: 0;
        transform: translateY(-8px);
        transition: all 0.25s;
        pointer-events: none;
      }
      .toast.show {
        opacity: 1;
        transform: none;
      }
      .toast.error {
        background: #d9534f;
      }
    </style>
  </head>
  <body>
    <div class="shell">
      <aside class="sidebar">
        <a class="brand" href="/admin">
          <span class="brand-mark" aria-hidden="true"></span>
          <span>控制台</span>
        </a>
        <nav class="nav" aria-label="控制台导航">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class:list={['nav-item', { active: active === item.key }]}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <div class="sidebar-bottom">
          <a class="nav-item" href="/" target="_blank">查看站点</a>
          <button class="nav-item logout" data-logout>退出登录</button>
        </div>
      </aside>
      <main class="content">
        <header class="topbar">
          <h1>{title}</h1>
          <span class="mode-badge">动态版</span>
        </header>
        <slot />
      </main>
    </div>

    <div class="toast" data-toast role="status"></div>

    <script>
      // 退出登录
      document.querySelector('[data-logout]')?.addEventListener('click', async () => {
        await fetch('/admin/api/logout', { method: 'POST' })
        location.href = '/admin/login'
      })

      // 全局 toast
      const toast = document.querySelector<HTMLElement>('[data-toast]')!
      let toastTimer: number | undefined
      ;(window as unknown as { toast: (msg: string, isError?: boolean) => void }).toast = (
        msg: string,
        isError = false
      ) => {
        toast.textContent = msg
        toast.classList.toggle('error', isError)
        toast.classList.add('show')
        window.clearTimeout(toastTimer)
        toastTimer = window.setTimeout(() => toast.classList.remove('show'), 2600)
      }
    </script>
  </body>
</html>

<style>
  .shell {
    display: grid;
    grid-template-columns: 220px 1fr;
    min-height: 100vh;
  }
  .sidebar {
    background: var(--a-surface);
    border-right: 1px solid var(--a-border);
    display: flex;
    flex-direction: column;
    padding: 18px 12px;
    gap: 8px;
    position: sticky;
    top: 0;
    height: 100vh;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 10px 18px;
    font-weight: 600;
    font-size: 15px;
    color: var(--a-fg);
    text-decoration: none;
  }
  .brand-mark {
    width: 26px;
    height: 26px;
    border-radius: 8px;
    background: linear-gradient(135deg, var(--a-primary), #9aa5b5);
  }
  .nav {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
  }
  .nav-item {
    display: block;
    padding: 9px 12px;
    border-radius: 10px;
    font-size: 13px;
    color: var(--a-fg-muted);
    text-decoration: none;
    background: none;
    border: none;
    text-align: left;
    cursor: pointer;
    font-family: inherit;
    transition: background 0.15s, color 0.15s;
  }
  .nav-item:hover {
    background: var(--a-primary-soft);
    color: var(--a-primary);
  }
  .nav-item.active {
    background: var(--a-primary-soft);
    color: var(--a-primary);
    font-weight: 600;
  }
  .sidebar-bottom {
    display: flex;
    flex-direction: column;
    gap: 2px;
    border-top: 1px solid var(--a-border);
    padding-top: 10px;
  }
  .logout:hover {
    color: #d9534f;
  }
  .content {
    padding: 24px 32px 48px;
    max-width: 960px;
    width: 100%;
  }
  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
  }
  .topbar h1 {
    font-size: 20px;
    font-weight: 600;
  }
  .mode-badge {
    font-size: 11px;
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--a-primary-soft);
    color: var(--a-primary);
  }

  @media (max-width: 768px) {
    .shell {
      grid-template-columns: 1fr;
    }
    .sidebar {
      position: static;
      height: auto;
      flex-direction: row;
      align-items: center;
      overflow-x: auto;
      padding: 10px 14px;
    }
    .brand {
      padding: 4px 12px 4px 0;
      white-space: nowrap;
    }
    .nav {
      flex-direction: row;
    }
    .nav-item {
      white-space: nowrap;
    }
    .sidebar-bottom {
      border: none;
      padding: 0;
      flex-direction: row;
      margin-left: auto;
    }
    .content {
      padding: 20px 16px 40px;
    }
  }
</style>
