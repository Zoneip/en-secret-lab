{
  "name": "en-secret-lab",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "gen:themes": "node scripts/gen-theme-css.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "build": "npm run gen:themes && astro build",
    "build:static": "npm run gen:themes && ASTRO_MODE=static astro build && node scripts/clean-static.mjs && pagefind --site dist-static",
    "build:server": "npm run gen:themes && ASTRO_MODE=server astro build",
    "preview": "astro preview",
    "sync": "astro sync",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run check && npm run test && npm run build:static"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.0.0",
    "@astrojs/node": "^9.0.0",
    "@astrojs/react": "^5.0.0",
    "@astrojs/rss": "^4.0.0",
    "@astrojs/sitemap": "^3.2.0",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "@fontsource/noto-sans-sc": "^5.1.0",
    "@fontsource/zcool-kuaile": "^5.1.0",
    "@fontsource/zcool-qingke-huangyou": "^5.1.0",
    "@pagefind/default-ui": "^1.5.2",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tailwindcss/vite": "^4.3.3",
    "@types/markdown-it": "^14.1.2",
    "astro": "^5.0.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.28.0",
    "markdown-it": "^15.0.0",
    "pagefind": "^1.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@eslint/js": "^10.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^10.0.0",
    "eslint-plugin-astro": "^1.3.0",
    "prettier": "^3.9.0",
    "prettier-plugin-astro": "^0.14.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
